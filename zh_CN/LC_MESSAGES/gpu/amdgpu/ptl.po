#: ../../../gpu/amdgpu/ptl.rst:3
msgid "Peak Tops Limiter (PTL) sysfs Interface"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:6
msgid "Overview"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:7
msgid ""
"The Peak Tops Limiter (PTL) sysfs interface enables users to control and "
"configure the PTL feature for each GPU individually.  All PTL-related sysfs "
"files are located under `/sys/class/drm/cardX/device/ptl/`, where `X` is the "
"GPU index.  Through these files, users can enable or disable PTL, set "
"preferred data formats, and query supported formats for each GPU."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:14
msgid "PTL sysfs files"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:15
msgid ""
"The following files are available under `/sys/class/drm/cardX/device/ptl/`:"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:17
msgid "`ptl_enable`"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:18
msgid "`ptl_format`"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:19
msgid "`ptl_supported_formats`"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:22
msgid "PTL Enable/Disable"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:23
msgid "File: `ptl_enable` Type: Read/Write (rw)"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:26
msgid ""
"Read: Returns the current PTL status as a string: `enabled` if PTL is "
"active, or `disabled` if inactive."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:29
msgid "Write:"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:31
msgid "Write `1` or `enabled` to enable PTL"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:32
msgid "Write `0` or `disabled` to disable PTL"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:34 ../../../gpu/amdgpu/ptl.rst:59
msgid "Examples::"
msgstr "示例："

#: ../../../gpu/amdgpu/ptl.rst:47
msgid "PTL Format (Preferred Data Formats)"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:48
msgid "File: `ptl_format` Type: Read/Write (rw)"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:51
msgid "Read: Returns the two preferred formats, e.g. `I8,F32`."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:53
msgid "Write: Accepts two formats separated by a comma, e.g. `I8,F32`."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:55
msgid "Both formats must be supported and different."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:56
msgid ""
"If an invalid format is provided (not supported, or both formats are the "
"same), the driver will return \"write error: Invalid argument\"."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:69
msgid "Supported Formats"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:70
msgid "File: `ptl_supported_formats` Type: Read-only (r)"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:73
msgid ""
"Read: Returns a comma-separated list of supported formats, e.g. `I8,F16,BF16,"
"F32,F64`."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:76
msgid "Example::"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:83
msgid "Behavioral Notes"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:84
msgid "PTL formats can only be set when PTL is enabled."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:85
msgid "If PTL is disabled, `ptl_format` returns `N/A`."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:86
msgid ""
"Only two formats can be set at a time, and they must be from the supported "
"set and different.."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:87
msgid "All commands support per-GPU targeting."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:88
msgid "Root permission is required to enable/disable PTL or change formats."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:89
msgid ""
"If the hardware does not support PTL, the PTL sysfs directory will not be "
"created."
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:93
msgid "Implementation"
msgstr ""

#: ../../../gpu/amdgpu/ptl.rst:94
msgid ""
"The PTL sysfs nodes are implemented in `drivers/gpu/drm/amd/amdgpu/"
"amdgpu_psp.c`."
msgstr ""
