#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:5
msgid "Motorcomm yt8xxx PHY properties (_DSD)"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:7
msgid ""
"This document describes ACPI _DSD device properties for Motorcomm yt8xxx "
"Ethernet PHYs supported by the in-kernel driver in ``drivers/net/phy/"
"motorcomm.c``."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:11
msgid ""
"The properties are exposed on the PHY device object under the MDIO bus ACPI "
"device (the same objects that are registered via "
"``fwnode_mdiobus_register_phy()``). MAC-side connection properties such as "
"``phy-handle`` and ``phy-mode`` are documented in [acpi-mdio-phy]_."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:16
msgid ""
"Property names and semantics are intentionally aligned with the Devicetree "
"binding [motorcomm-yt8xxx]_ so that the same driver code path "
"(``device_property_*`` on ``&phydev->mdio.dev``) can consume firmware "
"described either as Devicetree or ACPI _DSD."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:22
msgid "UUID and placement"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:24
msgid ""
"Per [acpi-dsd-properties-rules]_ and [acpi-mdio-phy]_, properties must be "
"placed in an _DSD package using the standard Device Properties UUID::"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:30
msgid "Properties"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:32
msgid ""
"Unless noted otherwise, integer properties use the same allowed values and "
"defaults as [motorcomm-yt8xxx]_."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:35
msgid "``rx-internal-delay-ps`` (u32, optional)"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:36
msgid ""
"RGMII RX internal delay in picoseconds. Only meaningful when the link is "
"using RGMII modes with RX internal delay; see [motorcomm-yt8xxx]_."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:39
msgid "``tx-internal-delay-ps`` (u32, optional)"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:40
msgid ""
"RGMII TX internal delay in picoseconds. Only meaningful when the link is "
"using RGMII modes with TX internal delay; see [motorcomm-yt8xxx]_."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:43
msgid "``motorcomm,clk-out-frequency-hz`` (u32, optional)"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:44
msgid ""
"Clock output frequency on the PHY clock output pin. Allowed values and "
"default are defined in [motorcomm-yt8xxx]_."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:47
msgid "``motorcomm,keep-pll-enabled`` (boolean, optional)"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:48
msgid ""
"If true, keep the PLL enabled even when there is no link (useful for using "
"the clock output without an Ethernet link). See [motorcomm-yt8xxx]_."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:51
msgid "``motorcomm,auto-sleep-disabled`` (boolean, optional)"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:52
msgid ""
"If true, disable the PHY auto-sleep behavior described in [motorcomm-"
"yt8xxx]_."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:55
msgid "``motorcomm,rx-clk-drv-microamp`` (u32, optional)"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:56
msgid ""
"Drive strength for the ``rx_clk`` RGMII pad in microamps. Allowed values "
"depend on the configured RGMII LDO voltage; see [motorcomm-yt8xxx]_."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:59
msgid "``motorcomm,rx-data-drv-microamp`` (u32, optional)"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:60
msgid ""
"Drive strength for the ``rx_data`` and ``rx_ctl`` RGMII pads in microamps. "
"See [motorcomm-yt8xxx]_."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:63
msgid "``motorcomm,tx-clk-adj-enabled`` (boolean, optional)"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:64
msgid ""
"Enables adjustments related to ``motorcomm,tx-clk-*-inverted`` usage; see "
"[motorcomm-yt8xxx]_."
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:67
msgid ""
"``motorcomm,tx-clk-10-inverted`` (boolean, optional) ``motorcomm,tx-clk-100-"
"inverted`` (boolean, optional) ``motorcomm,tx-clk-1000-inverted`` (boolean, "
"optional)"
msgstr ""

#: ../../../firmware-guide/acpi/dsd/motorcomm-yt8xxx-phy.rst:70
msgid "Per-speed TX clock inversion options; see [motorcomm-yt8xxx]_."
msgstr ""

