#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1780
msgid ""
"If using this macro in param_init(), kunit_array_gen_params() will then need "
"to be manually provided as the parameter generator function to "
"KUNIT_CASE_PARAM_WITH_INIT(). kunit_array_gen_params() is a KUnit function "
"that uses the registered array to generate parameters"
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1831
msgid "``kunit_warning_suppress (test)``"
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1829
msgid "Suppress WARN*() backtraces for the duration of a block."
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1832
msgid ""
"Scoped form of the suppression API. Suppression starts when the block is "
"entered and ends automatically when the block exits through any path. See "
"the section comment above for the cleanup guarantees on each exit path. "
"Fails the test if suppression is already active; nesting is not supported."
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1837
msgid ""
"The warning count can be checked inside the block via "
"KUNIT_EXPECT_SUPPRESSED_WARNING_COUNT(). The handle is not accessible after "
"the block exits."
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1841
msgid "Example::"
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1860
msgid "``KUNIT_SUPPRESSED_WARNING_COUNT ()``"
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1858
msgid "Returns the suppressed warning count."
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1859
msgid ""
"Returns the number of WARN*() calls suppressed since the current suppression "
"block started, or 0 if the handle is NULL. Usable inside a "
"kunit_warning_suppress() block."
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1870
msgid "``KUNIT_EXPECT_SUPPRESSED_WARNING_COUNT (test, expected)``"
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1868
msgid ""
"Sets an expectation that the suppressed warning count equals **expected**."
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1873
#: ../include/kunit/test.h:1888
msgid "``expected``"
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1872
#: ../include/kunit/test.h:1887
msgid "an expression that evaluates to the expected warning count."
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1873
msgid ""
"Sets an expectation that the number of suppressed WARN*() calls equals "
"**expected**. This is semantically equivalent to KUNIT_EXPECT_EQ(**test**, "
"KUNIT_SUPPRESSED_WARNING_COUNT(), **expected**). See KUNIT_EXPECT_EQ() for "
"more information."
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1885
msgid "``KUNIT_ASSERT_SUPPRESSED_WARNING_COUNT (test, expected)``"
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1883
msgid ""
"Sets an assertion that the suppressed warning count equals **expected**."
msgstr ""

#: ../../../dev-tools/kunit/api/test:9: ../include/kunit/test.h:1888
msgid ""
"Sets an assertion that the number of suppressed WARN*() calls equals "
"**expected**. This is the same as KUNIT_EXPECT_SUPPRESSED_WARNING_COUNT(), "
"except it causes an assertion failure (see KUNIT_ASSERT_TRUE()) when the "
"assertion is not met."
msgstr ""
