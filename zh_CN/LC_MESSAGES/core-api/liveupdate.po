msgid ""
"The total number of files that were part of this session during "
"serialization. Used for iteration and validation during restoration."
msgstr ""

#: ../../../core-api/liveupdate:42: ../include/linux/kho/abi/luo.h:119
msgid "Represents the serialized metadata for a LUO session."
msgstr ""

#: ../../../core-api/liveupdate:42: ../include/linux/kho/abi/luo.h:120
#: ../include/linux/kho/abi/luo.h:159
msgid "``name``"
msgstr ""

#: ../../../core-api/liveupdate:42: ../include/linux/kho/abi/luo.h:121
msgid ""
"The unique name of the session, provided by the userspace at the time of "
"session creation."
msgstr ""

#: ../../../core-api/liveupdate:42: ../include/linux/kho/abi/luo.h:122
msgid "``file_set_ser``"
msgstr ""

#: ../../../core-api/liveupdate:42: ../include/linux/kho/abi/luo.h:123
