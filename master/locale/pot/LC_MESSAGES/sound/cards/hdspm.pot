#: ../../../sound/cards/hdspm.rst:233
msgid "Access -- Read Write"
msgstr ""

#: ../../../sound/cards/hdspm.rst:105
msgid "Values -- \"Master\" \"Slave\""
msgstr ""

#: ../../../sound/cards/hdspm.rst:108
msgid ""
"!!!! This is a hardware function but is in conflict with the Clock-source "
"controller, which is a kind of ALSA-standard. It makes sense to set the card "
"to a special mode (master at some frequency or slave), since even not using "
"an Audio application a studio should have working synchronisations setup. So "
"use Clock-source controller instead !!!!"
msgstr ""

#: ../../../sound/cards/hdspm.rst:115
msgid "Clock Source"
msgstr ""

#: ../../../sound/cards/hdspm.rst:117
msgid "Name -- \"Sample Clock Source\""
msgstr ""

#: ../../../sound/cards/hdspm.rst:121
msgid ""
"Values -- \"AutoSync\", \"Internal 32.0 kHz\", \"Internal 44.1 kHz\", "
"\"Internal 48.0 kHz\", \"Internal 64.0 kHz\", \"Internal 88.2 kHz\", "
"\"Internal 96.0 kHz\""
msgstr ""

#: ../../../sound/cards/hdspm.rst:125
msgid ""
"Choose between Master at a specific Frequency and so also the Speed-mode or "
"Slave (Autosync). Also see \"Preferred Sync Ref\"."
msgstr ""

#: ../../../sound/cards/hdspm.rst:129
msgid ""
"!!!! This is not a pure hardware function but was implemented by ALSA by "
"some ALSA drivers before, so I use it also. !!!"
msgstr ""

