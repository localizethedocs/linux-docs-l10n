msgid ""
"request the initialization of the VGIC, no additional parameter in "
"kvm_device_attr.addr. Must be called after all VCPUs have been created."
msgstr ""

#: ../../../virt/kvm/devices/arm-vgic-v5.rst:55
msgid "KVM_DEV_ARM_VGIC_USERSPACE_PPIS"
msgstr ""

#: ../../../virt/kvm/devices/arm-vgic-v5.rst:56
msgid ""
"request the mask of userspace-drivable PPIs. Only a subset of the PPIs can "
"be directly driven from userspace with GICv5, and the returned mask informs "
"userspace of which it is allowed to drive via KVM_IRQ_LINE."
msgstr ""

#: ../../../virt/kvm/devices/arm-vgic-v5.rst:60
msgid ""
"Userspace must allocate and point to __u64[2] of data in "
"kvm_device_attr.addr. When this call returns, the provided memory will be "
"populated with the userspace PPI mask. The lower __u64 contains the mask for "
"the lower 64 PPIS, with the remaining 64 being in the second __u64."
msgstr ""

