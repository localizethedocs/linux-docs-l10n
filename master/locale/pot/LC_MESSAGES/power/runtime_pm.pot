#: ../../../power/runtime_pm:311: ../include/linux/pm.h:705
msgid "Work structure used for queuing up requests into pm_wq (runtime PM)."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:705
msgid "``wait_queue``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:706
msgid ""
"Wait queue used if any helper functions need to wait for another state "
"change to complete (runtime PM)."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:707
msgid "``wakeirq``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:708
msgid "Dedicated wakeup interrupt for the device."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:708
msgid "``usage_count``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:709
msgid "Device runtime PM usage counter."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:709
msgid "``child_count``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:710
msgid "Count of active children of the device (runtime PM)."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:710
msgid "``disable_depth``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:711
msgid ""
"Disable counter for runtime PM (runtime PM is enabled when this is 0; "
"initial value is 1)."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:712
msgid "``idle_notification``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:713
msgid "Set if ->runtime_idle() is being executed."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:713
msgid "``request_pending``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:714
msgid "Set if a work item is queued into pm_wq (runtime PM)."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:714
msgid "``deferred_resume``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:715
msgid ""
"Set if ->runtime_resume() should run as soon as ->runtime_suspend() "
"completes."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:716
msgid "``needs_force_resume``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:717
msgid ""
"Indicates the device was forced into suspend by pm_runtime_force_suspend() "
"and must be resumed by pm_runtime_force_resume()."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:719
msgid "``runtime_auto``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:720
msgid ""
"User space has allowed the driver to power manage the device at runtime via "
"sysfs control attribute; also can be set by pm_runtime_allow() or "
"pm_runtime_forbid()."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:722
msgid "``ignore_children``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:723
msgid ""
"If set, the value of child_count is ignored for runtime suspend and idle "
"decisions."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:724
msgid "``no_callbacks``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:725
msgid "Indicates the device does not use runtime PM callbacks."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:725
msgid "``irq_safe``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:726
msgid ""
"Indicates runtime PM callbacks will be invoked with the spinlock held and "
"interrupts disabled."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:727
msgid "``use_autosuspend``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:728
msgid "Indicates the device driver supports delayed runtime autosuspend."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:729
msgid "``timer_autosuspends``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:730
msgid ""
"Indicates the runtime PM core should attempt an autosuspend rather than a "
"normal suspend when the timer expires."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:731
msgid "``memalloc_noio``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:732
msgid ""
"Indicates memory allocation during runtime PM transitions must avoid I/O "
"(GFP_NOIO)."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:733
msgid "``links_count``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:734
msgid "Number of device links that require runtime PM coordination."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:734
msgid "``request``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:735
msgid "Type of pending runtime PM request (valid if request_pending is set)."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:736
msgid "``runtime_status``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:737
msgid "Runtime PM status of the device."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:737
msgid "``last_status``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:738
msgid ""
"Last status captured before disabling runtime PM, or ``RPM_BLOCKED`` / "
"``RPM_INVALID``."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:739
msgid "``runtime_error``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:740
msgid ""
"Fatal error code returned by a failing callback, blocking helpers until "
"cleared."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:741
msgid "``autosuspend_delay``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:742
msgid "Delay time in milliseconds to be used for runtime autosuspend."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:743
msgid "``last_busy``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:744
msgid ""
"Timestamp in nanoseconds when pm_runtime_mark_last_busy() was last called. "
"Used in calculating inactivity periods for autosuspend."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:745
msgid "``active_time``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:746
msgid "Accumulated time in nanoseconds spent in ``RPM_ACTIVE`` state."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:746
msgid "``suspended_time``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:747
msgid "Accumulated time in nanoseconds spent in ``RPM_SUSPENDED`` state."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:748
msgid "``accounting_timestamp``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:749
msgid ""
"Timestamp in nanoseconds of the last runtime PM state accounting update."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:750
msgid "``subsys_data``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:751
msgid "Subsystem-specific power management data."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:751
msgid "``set_latency_tolerance``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:752
msgid "Callback for setting latency tolerance."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:752
msgid "``qos``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:753
msgid "Per-device PM Quality of Service (QoS) constraints."
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:753
msgid "``detach_power_off``"
msgstr ""

#: ../../../power/runtime_pm:311: ../include/linux/pm.h:754
msgid "Indicates device should be detached from PM domain on power off."
msgstr ""

