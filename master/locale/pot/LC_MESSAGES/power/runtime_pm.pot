#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1105
msgid "Core entry point for runtime idle operations."
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1106
msgid "Device to send idle notification for."
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1108
#: ../drivers/base/power/runtime.c:1145 ../drivers/base/power/runtime.c:1182
msgid "``int rpmflags``"
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1107
#: ../drivers/base/power/runtime.c:1144 ../drivers/base/power/runtime.c:1181
msgid "Flag bits."
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1108
msgid ""
"Carry out an idle check for **dev**, either synchronous or asynchronous. If "
"``RPM_GET_PUT`` is set in **rpmflags**, decrement the device's usage count "
"first, proceeding with idle notification only if the counter drops to zero."
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1112
#: ../drivers/base/power/runtime.c:1149 ../drivers/base/power/runtime.c:1186
msgid ""
"This routine may be called in atomic context if the ``RPM_ASYNC`` flag is "
"set, or if pm_runtime_irq_safe() has been called."
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1142
msgid "Core entry point for runtime put/suspend operations."
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1145
msgid ""
"Carry out a suspend operation for **dev**, either synchronous or "
"asynchronous. If ``RPM_GET_PUT`` is set in **rpmflags**, decrement the "
"device's usage count first, proceeding with suspend only if the counter "
"drops to zero."
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1179
msgid "Core entry point for runtime resume operations."
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1180
#: ../drivers/base/power/runtime.c:2070 ../../../power/runtime_pm:549:
#: ../drivers/base/power/generic_ops.c:35
#: ../drivers/base/power/generic_ops.c:168
#: ../drivers/base/power/generic_ops.c:178
#: ../drivers/base/power/generic_ops.c:188
#: ../drivers/base/power/generic_ops.c:208
msgid "Device to resume."
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1182
msgid ""
"Carry out a runtime resume operation for **dev**, either synchronous or "
"asynchronous. If ``RPM_GET_PUT`` is set in **rpmflags**, increment the "
"device's usage count first, then bring the device to ``RPM_ACTIVE`` state."
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1257
#: ../drivers/base/power/runtime.c:1275
msgid "Conditionally bump up runtime PM usage counter."
msgstr ""

#: ../../../power/runtime_pm:322: ../drivers/base/power/runtime.c:1258
