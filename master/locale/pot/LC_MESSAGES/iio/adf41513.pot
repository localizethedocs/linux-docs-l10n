msgid "Resolution: :math:`f_{PFD} / 2^{25}`"
msgstr ""

#: ../../../iio/adf41513.rst:129
msgid "Simpler implementation, faster settling"
msgstr ""

#: ../../../iio/adf41513.rst:131
msgid "**Variable Modulus (49-bit)**:"
