#: ../../../iio/adf41513.rst:139
msgid "Phase noise: -231 dBc/Hz normalized floor"
msgstr ""

#: ../../../iio/adf41513.rst:140
msgid "Maximum PFD frequency: 125 MHz"
msgstr ""

#: ../../../iio/adf41513.rst:141
msgid "Bleed current: Automatically enabled and optimized"
msgstr ""

#: ../../../iio/adf41513.rst:142
msgid "Dithering: Enabled to reduce fractional spurs"
