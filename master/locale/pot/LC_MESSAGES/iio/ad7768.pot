#: ../../../iio/ad7768.rst:235
msgid "Hardware-driven data capture"
msgstr ""

#: ../../../iio/ad7768.rst:236
msgid "DMA-based data transfer for minimal CPU overhead"
msgstr ""

#: ../../../iio/ad7768.rst:237
msgid "CRC error detection"
msgstr ""

#: ../../../iio/ad7768.rst:239
msgid "See :doc:`iio_devbuf` for more information about IIO device buffers."
msgstr ""

