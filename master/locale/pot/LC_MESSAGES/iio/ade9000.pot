#: ../../../iio/ade9000.rst:122
msgid "3. Calibration and scaling"
msgstr ""

#: ../../../iio/ade9000.rst:124
msgid "The ADE9000 provides multiple levels of gain and offset correction:"
msgstr ""

#: ../../../iio/ade9000.rst:126
msgid "**Calibration Gain (per-channel)**"
msgstr ""

#: ../../../iio/ade9000.rst:127
msgid ""
"Fine-tuning calibration gains applied in the digital domain for each channel "
"type. Controlled via ``calibscale`` attributes (AIGAIN, AVGAIN, APGAIN "
"registers)."
msgstr ""

#: ../../../iio/ade9000.rst:130
msgid "**Calibration Bias (per-channel)**"
msgstr ""

#: ../../../iio/ade9000.rst:131
msgid "Hardware calibration offsets applied by the device internally:"
msgstr ""

#: ../../../iio/ade9000.rst:133
msgid ""
"Power measurements: Controlled via ``calibbias`` attributes for power "
"channels (xWATTOS, xVAROS registers)."
msgstr ""

#: ../../../iio/ade9000.rst:134
msgid ""
"RMS measurements: Controlled via ``calibbias`` attributes for RMS channels "
"(IRMSOS, VRMSOS registers)."
msgstr ""

#: ../../../iio/ade9000.rst:136
msgid "These are internal chip calibrations, not userspace-applied offsets."
msgstr ""

