#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:158
msgid "Find a node which matches the key"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:160
msgid ""
"Search a (key) node whose key matches **key** from whole of XBC tree and "
"return the node if found. If not found, returns NULL."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:170
msgid "Return the first subkey node if exists"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:171
msgid "Parent node"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:172
msgid ""
"Return the first subkey node of the **node**. If the **node** has no child "
"or only value node, this will return NULL."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:189
msgid "``xbc_array_for_each_value (anode, value)``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:187
msgid "Iterate value nodes on an array"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:193
#: ../include/linux/bootconfig.h:229
msgid "``anode``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:188
msgid "An XBC arraied value node"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:190
#: ../include/linux/bootconfig.h:230 ../include/linux/bootconfig.h:249
#: ../include/linux/bootconfig.h:261
msgid "``value``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:189
msgid "A value"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:190
msgid ""
"Iterate array value nodes and values starts from **anode**. This is expected "
"to be used with xbc_find_value() and xbc_node_find_value(), so that user can "
"process each array entry node."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:203
msgid "``xbc_node_for_each_child (parent, child)``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:201
msgid "Iterate child nodes"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:207
#: ../include/linux/bootconfig.h:219
msgid "``parent``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:204
#: ../include/linux/bootconfig.h:216
msgid "``child``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:203
#: ../include/linux/bootconfig.h:215
msgid "Iterated XBC node."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:204
msgid ""
"Iterate child nodes of **parent**. Each child nodes are stored to **child**. "
"The **child** can be mixture of a value node and subkey nodes."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:215
msgid "``xbc_node_for_each_subkey (parent, child)``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:213
msgid "Iterate child subkey nodes"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:216
msgid ""
"Iterate subkey nodes of **parent**. Each child nodes are stored to "
"**child**. The **child** is only the subkey node."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:227
msgid "``xbc_node_for_each_array_value (node, key, anode, value)``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:225
msgid "Iterate array entries of geven key"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:231
#: ../include/linux/bootconfig.h:251
msgid "``node``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:228
msgid "``key``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:227
msgid "A key string searched under **node**"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:228
msgid "Iterated XBC node of array entry."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:229
msgid "Iterated value of array entry."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:230
msgid ""
"Iterate array entries of given **key** under **node**. Each array entry node "
"is stored to **anode** and **value**. If the **node** doesn't have **key** "
"node, it does nothing. Note that even if the found key node has only one "
"value (not array) this executes block once. However, if the found key node "
"has no value (key-only node), this does nothing. So don't use this for "
"testing the key-value pair existence."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:247
msgid "``xbc_node_for_each_key_value (node, knode, value)``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:245
msgid "Iterate key-value pairs under a node"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:248
#: ../include/linux/bootconfig.h:264
msgid "``knode``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:247
#: ../include/linux/bootconfig.h:259
msgid "Iterated key node"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:248
#: ../include/linux/bootconfig.h:260
msgid "Iterated value string"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:249
msgid ""
"Iterate key-value pairs under **node**. Each key node and value string are "
"stored in **knode** and **value** respectively."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:260
msgid "``xbc_for_each_key_value (knode, value)``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:258
msgid "Iterate key-value pairs"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:261
msgid ""
"Iterate key-value pairs in whole XBC tree. Each key node and value string "
"are stored in **knode** and **value** respectively."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:284
msgid "Compose full key string of the XBC node"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:287
#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:406
#: ../lib/bootconfig.c:545
msgid "``char *buf``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:286
#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:405
msgid "A buffer to store the key."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:288
#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:72
#: ../lib/bootconfig.c:407 ../lib/bootconfig.c:542 ../lib/bootconfig.c:1166
msgid "``size_t size``"
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:287
#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:406
msgid "The size of the **buf**."
msgstr ""

#: ../../../admin-guide/bootconfig:414: ../include/linux/bootconfig.h:288
msgid ""
"Compose the full-length key of the **node** into **buf**. Returns the total "
"length of the key stored in **buf**. Or returns -EINVAL if **node** is NULL, "
"and -ERANGE if the key depth is deeper than max depth."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:69
msgid "Prepend embedded bootconfig cmdline"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:75
msgid "``char *dst``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:70
msgid "cmdline buffer to prepend into (must already contain a NUL byte)"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:71
msgid "total capacity of **dst** in bytes"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:72
msgid ""
"Prepend the build-time-rendered \"kernel\" subtree of the embedded "
"bootconfig to **dst**. The rendered string already ends with a single space "
"(the xbc_snprint_cmdline() invariant), which serves as the separator between "
"the embedded keys and any existing content of **dst**. On overflow, log an "
"error and leave **dst** untouched rather than silently truncating: booting "
"without the embedded values is better than refusing to boot, and the error "
"message tells the user why their embedded keys are missing."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:81
msgid ""
"Intended to be called from setup_arch() before parse_early_param() so that "
"early_param() handlers see the embedded values."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:106
msgid "Did the embedded cmdline get prepended?"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:112
#: ../lib/bootconfig.c:244 ../lib/bootconfig.c:1151
msgid "``void``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1
msgid "no arguments"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:107
msgid ""
"Return true if xbc_prepend_embedded_cmdline() actually prepended the "
"embedded \"kernel\" subtree. setup_boot_config() uses this to avoid "
"rendering the same keys a second time."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:128
msgid "Was \"bootconfig\" passed on the cmdline?"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:134
msgid "``const char *boot_cmdline``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:129
msgid "kernel command line to inspect (not modified)"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:131
msgid "``int *end_offset``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:130
msgid ""
"if non-NULL, set to the offset of the init arguments that follow a \"--\" "
"separator, or 0 when there is none"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:132
msgid ""
"Parse a private copy of **boot_cmdline** (parse_args() is destructive) and "
"report whether \"bootconfig\" is present before the \"--\" separator. "
"setup_arch() uses this to gate prepending the build-time embedded cmdline; "
"setup_boot_config() uses it for the runtime opt-in and to locate the init "
"arguments via **end_offset**. Sharing one parser keeps the early and late "
"paths agreeing on what counts as opt-in. CONFIG_BOOT_CONFIG_FORCE is not "
"folded in here; callers apply it where they need it."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:209
msgid "Get the information of loaded boot config"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:215
msgid "``int *node_size``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:210
msgid "A pointer to store the number of nodes."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:212
msgid "``size_t *data_size``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:211
msgid "A pointer to store the size of bootconfig data."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:212
msgid ""
"Get the number of used nodes in **node_size** if it is not NULL, and the "
"size of bootconfig data in **data_size** if it is not NULL. Return 0 if the "
"boot config is initialized, or return -ENODEV."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:238
msgid "Get the root node of extended boot config"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:239
msgid ""
"Return the address of root node of extended boot config. If the extended "
"boot config is not initialized, return NULL."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:252
msgid "Get the index of XBC node"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:253
msgid "A target node of getting index."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:254
msgid "Return the index number of **node** in XBC node list."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:263
msgid "Get the parent XBC node"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:265
msgid ""
"Return the parent node of **node**. If the node is top node of the tree, "
"return NULL."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:275
msgid "Get the child XBC node"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:277
msgid ""
"Return the first child node of **node**. If the node has no child, return "
"NULL."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:287
msgid "Get the next sibling XBC node"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:289
msgid ""
"Return the NEXT sibling node of **node**. If the node has no next sibling, "
"return NULL. Note that even if this returns NULL, it doesn't mean **node** "
"has no siblings. (You also has to check whether the parent's child node is "
"**node** or not.)"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:301
msgid "Get the data of XBC node"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:303
msgid ""
"Return the data (which is always a null terminated string) of **node**. If "
"the node has invalid data, warn and return NULL."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:337
msgid "Find a subkey node which matches given key"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:343
#: ../lib/bootconfig.c:374
msgid "``struct xbc_node *parent``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:339
#: ../lib/bootconfig.c:370
msgid "A key string."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:340
msgid ""
"Search a key node under **parent** which matches **key**. The **key** can "
"contain several words jointed with '.'. If **parent** is NULL, this searches "
"the node from whole tree. Return NULL if no node is matched."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:368
msgid "Find a value node which matches given key"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:371
msgid "A container pointer of found XBC node."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:372
msgid ""
"Search a value node under **parent** whose (parent) key node matches "
"**key**, store it in ***vnode**, and returns the value string. The **key** "
"can contain several words jointed with '.'. If **parent** is NULL, this "
"searches the node from whole tree. Return the value string if a matched key "
"found, return NULL if no node is matched. Note that this returns 0-length "
"string and stores NULL in ***vnode** if the key has no value. And also it "
"will return the value of the first entry if the value is an array."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:402
msgid "Compose partial key string of the XBC node"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:408
#: ../lib/bootconfig.c:464 ../lib/bootconfig.c:514 ../lib/bootconfig.c:543
msgid "``struct xbc_node *root``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:403
msgid "Root XBC node"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:404
msgid "Target XBC node."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:407
msgid ""
"Compose the partial key of the **node** into **buf**, which is starting "
"right after **root** (**root** is not included.) If **root** is NULL, this "
"returns full key words of **node**. Returns the total length of the key "
"stored in **buf**. Returns -EINVAL if **node** is NULL or **root** is not "
"the ancestor of **node** or **root** is **node**, or returns -ERANGE if the "
"key depth is deeper than max depth. This is expected to be used with "
"xbc_find_node() to list up all (child) keys under given key."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:458
msgid "Find the next leaf node under given node"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:459
#: ../lib/bootconfig.c:509
msgid "An XBC root node"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:460
msgid "An XBC node which starts from."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:461
msgid ""
"Search the next leaf node (which means the terminal key node) of **node** "
"under **root** node (including **root** node itself). Return the next node "
"or NULL if next leaf node is not found."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:508
msgid "Find the next key-value pair nodes"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:511
msgid "``struct xbc_node **leaf``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:510
msgid "A container pointer of XBC node which starts from."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:511
msgid ""
"Search the next leaf node (which means the terminal key node) of ***leaf** "
"under **root** node. Returns the value and update ***leaf** if next leaf "
"node is found, or NULL if no next leaf node is found. Note that this returns "
"0-length string if the key has no value, or the value of the first entry if "
"the value is an array."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:539
msgid "Render bootconfig keys as cmdline string"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:540
msgid "Destination buffer (may be NULL when **size** is 0 to query the length)"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:541
msgid "Size of **buf** in bytes"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:542
msgid "Subtree root whose key=value pairs should be rendered"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:544
msgid "``xbc_cmdline_filter_fn filter``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:543
msgid "Filter callback (returns true to include, false to skip; may be NULL)"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:545
msgid "``void *data``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:544
msgid "Private context passed to **filter**"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:545
msgid ""
"Walk all key/value pairs under **root** and emit them as a space-separated "
"cmdline string into **buf**. Values containing whitespace are quoted with "
"double quotes. Keys for which **filter** returns false are omitted. Returns "
"the number of bytes that would be written if **buf** were large enough "
"(matching snprintf semantics), or a negative errno on failure."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1145
msgid "Clean up all parsed bootconfig"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1146
msgid ""
"This clears all data structures of parsed bootconfig on memory. If you need "
"to reuse xbc_init() with new boot config, you can use this."
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1163
msgid "Parse given XBC file and build XBC internal tree"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1169
msgid "``const char *data``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1164
msgid "The boot config text original data"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1165
msgid "The size of **data**"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1167
msgid "``const char **emsg``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1166
msgid "A pointer of const char * to store the error message"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1168
msgid "``int *epos``"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1167
msgid "A pointer of int to store the error position"
msgstr ""

#: ../../../admin-guide/bootconfig:415: ../lib/bootconfig.c:1168
msgid ""
"This parses the boot config text in **data**. **size** must be smaller than "
"XBC_DATA_MAX. Return the number of stored nodes (>0) if succeeded, or -errno "
"if there is any error. In error cases, **emsg** will be updated with an "
"error message and **epos** will be updated with the error position which is "
"the byte offset of **buf**. If the error is not a parser error, **epos** "
"will be -1."
msgstr ""
