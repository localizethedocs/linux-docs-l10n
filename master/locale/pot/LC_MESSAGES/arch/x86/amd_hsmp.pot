#: ../../../arch/x86/amd_hsmp.rst:96
msgid "clk_fmin: Minimum frequency of socket in MHz."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:97
msgid "cclk_freq_limit_input: Core clock frequency limit per socket in MHz."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:98
msgid ""
"pwr_current_active_freq_limit: Current active frequency limit of socket in "
"MHz."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:100
msgid ""
"pwr_current_active_freq_limit_source: Source of current active frequency "
"limit."
msgstr ""

