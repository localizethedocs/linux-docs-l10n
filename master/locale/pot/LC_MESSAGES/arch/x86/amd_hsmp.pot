#: ../../../arch/x86/amd_hsmp.rst:94
msgid ""
"prochot_status: Reports 1 if the processor is at thermal threshold value, 0 "
"otherwise."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:96
msgid "smu_fw_version: SMU firmware version."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:97
msgid "protocol_version: HSMP interface version."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:98
msgid "ddr_max_bw: Theoretical maximum DDR bandwidth in GB/s."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:99
msgid "ddr_utilised_bw_input: Current utilized DDR bandwidth in GB/s."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:100
msgid ""
"ddr_utilised_bw_perc_input(%): Percentage of current utilized DDR bandwidth."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:101
msgid "mclk_input: Memory clock in MHz."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:102
msgid "fclk_input: Fabric clock in MHz."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:103
msgid "clk_fmax: Maximum frequency of socket in MHz."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:104
msgid "clk_fmin: Minimum frequency of socket in MHz."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:105
msgid "cclk_freq_limit_input: Core clock frequency limit per socket in MHz."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:106
msgid ""
"pwr_current_active_freq_limit: Current active frequency limit of socket in "
"MHz."
msgstr ""

#: ../../../arch/x86/amd_hsmp.rst:108
msgid ""
"pwr_current_active_freq_limit_source: Source of current active frequency "
"limit."
msgstr ""

