#: ../../../netlink/specs/dpll.yaml:463
msgid "fractional-frequency-offset (``sint``)"
msgstr ""

#: ../../../netlink/specs/dpll.yaml:463
msgid ""
"The FFO (Fractional Frequency Offset) of the pin. At top level this "
"represents the RX vs TX symbol rate offset on the media associated with the "
"pin. Inside the pin-parent-device nest it represents the frequency offset "
"between the pin and its parent DPLL device. For pins of type "
"PIN_TYPE_INT_NCO this represents the DPLL's current output frequency offset "
"from its nominal frequency. Value is in PPM (parts per million). This is a "
"lower-precision version of fractional-frequency-offset-ppt."
msgstr ""

#: ../../../netlink/specs/dpll.yaml:478
msgid "esync-frequency (``u64``)"
msgstr ""

#: ../../../netlink/specs/dpll.yaml:478
msgid ""
"Frequency of Embedded SYNC signal. If provided, the pin is configured with a "
"SYNC signal embedded into its base clock frequency."
msgstr ""

#: ../../../netlink/specs/dpll.yaml:484
msgid "esync-frequency-supported (``nest``)"
msgstr ""

#: ../../../netlink/specs/dpll.yaml:484
msgid ""
"If provided a pin is capable of embedding a SYNC signal (within given range) "
"into its base frequency signal."
msgstr ""

#: ../../../netlink/specs/dpll.yaml:492
msgid "esync-pulse (``u32``)"
msgstr ""

#: ../../../netlink/specs/dpll.yaml:492
msgid ""
"A ratio of high to low state of a SYNC signal pulse embedded into base clock "
"frequency. Value is in percents."
msgstr ""

#: ../../../netlink/specs/dpll.yaml:498
msgid "reference-sync (``nest``)"
msgstr ""

#: ../../../netlink/specs/dpll.yaml:498
msgid ":ref:`dpll-attribute-set-reference-sync`"
msgstr ""

#: ../../../netlink/specs/dpll.yaml:498
msgid ""
