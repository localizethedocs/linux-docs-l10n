#: ../../../netlink/specs/dpll.yaml:256
msgid ""
"phase offset divider allows userspace to calculate a value of measured "
"signal phase difference between a pin and dpll device as a fractional value "
"with three digit decimal precision. Value of (DPLL_A_PHASE_OFFSET / "
"DPLL_PHASE_OFFSET_DIVIDER) is an integer part of a measured phase offset "
"value. Value of (DPLL_A_PHASE_OFFSET % DPLL_PHASE_OFFSET_DIVIDER) is a "
"fractional part of a measured phase offset value."
msgstr ""

#: ../../../netlink/specs/dpll.yaml:268
msgid "pin-measured-frequency-divider"
msgstr ""

#: ../../../netlink/specs/dpll.yaml:268
msgid ""
"pin measured frequency divider allows userspace to calculate a value of "
"measured input frequency as a fractional value with three digit decimal "
"precision (millihertz). Value of (DPLL_A_PIN_MEASURED_FREQUENCY / "
"DPLL_PIN_MEASURED_FREQUENCY_DIVIDER) is an integer part of a measured "
"frequency value. Value of (DPLL_A_PIN_MEASURED_FREQUENCY % "
"DPLL_PIN_MEASURED_FREQUENCY_DIVIDER) is a fractional part of a measured "
"frequency value."
msgstr ""

