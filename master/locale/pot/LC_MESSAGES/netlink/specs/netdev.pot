msgstr ""

#: ../../../netlink/specs/netdev.yaml:353
msgid ":ref:`netdev-attribute-set-xsk-info`"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:358
msgid "lease (``nest``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:358
msgid ""
"A queue from a virtual device can have a lease which refers to another queue "
"from a physical device. This is useful for memory providers and AF_XDP "
"operations which take an ifindex and queue id to allow applications to bind "
"against virtual devices in containers."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:358
msgid ":ref:`netdev-attribute-set-lease`"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:358
msgid "qstats"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:358
msgid ""
"Get device statistics, scoped to a device or a queue. These statistics "
"extend (and partially duplicate) statistics available in struct "
"rtnl_link_stats64. Value of the `scope` attribute determines how statistics "
"are aggregated. When aggregated for the entire device the statistics "
"represent the total number of events since last explicit reset of the device "
"(i.e. not a reconfiguration like changing queue count). When reported per-"
"queue, however, the statistics may not add up to the total number of events, "
"will only be reported for currently active objects, and will likely report "
"the number of events since last reconfiguration."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:382
msgid "ifindex of the netdevice to which stats belong."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:388
msgid "queue-type (``u32``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:388
msgid "Queue type as rx, tx, for queue-id."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:393
msgid "queue-id (``u32``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:393
msgid "Queue ID, if stats are scoped to a single queue instance."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:397
msgid "scope (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:397
msgid "What object type should be used to iterate over the stats."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:397
msgid ":ref:`netdev-definition-qstats-scope`"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:403
msgid "rx-packets (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:403
msgid ""
"Number of wire packets successfully received and passed to the stack. For "
"drivers supporting XDP, XDP is considered the first layer of the stack, so "
"packets consumed by XDP are still counted here."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:411
msgid "rx-bytes (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:411
msgid "Successfully received bytes, see `rx-packets`."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:415
msgid "tx-packets (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:415
msgid ""
"Number of wire packets successfully sent. Packet is considered to be "
"successfully sent once it is in device memory (usually this means the device "
"has issued a DMA completion for the packet)."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:422
msgid "tx-bytes (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:422
msgid "Successfully sent bytes, see `tx-packets`."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:426
msgid "rx-alloc-fail (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:426
msgid ""
"Number of times skb or buffer allocation failed on the Rx datapath. "
"Allocation failure may, or may not result in a packet drop, depending on "
"driver implementation and whether system recovers quickly."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:433
msgid "rx-hw-drops (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:433
msgid ""
"Number of all packets which entered the device, but never left it, including "
"but not limited to: packets dropped due to lack of buffer space, processing "
"errors, explicit or implicit policies and packet filters."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:441
msgid "rx-hw-drop-overruns (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:441
msgid ""
"Number of packets dropped due to transient lack of resources, such as buffer "
"space, host descriptors etc."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:447
msgid "rx-csum-complete (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:447
msgid "Number of packets that were marked as CHECKSUM_COMPLETE."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:451
msgid "rx-csum-unnecessary (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:451
msgid "Number of packets that were marked as CHECKSUM_UNNECESSARY."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:455
msgid "rx-csum-none (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:455
msgid "Number of packets that were not checksummed by device."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:459
msgid "rx-csum-bad (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:459
msgid ""
"Number of packets with bad checksum. The packets are not discarded, but "
"still delivered to the stack."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:465
msgid "rx-hw-gro-packets (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:465
msgid ""
"Number of packets that were coalesced from smaller packets by the device. "
"Counts only packets coalesced with the HW-GRO netdevice feature, LRO-"
"coalesced packets are not counted."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:472
msgid "rx-hw-gro-bytes (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:472
msgid "See `rx-hw-gro-packets`."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:476
msgid "rx-hw-gro-wire-packets (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:476
msgid ""
"Number of packets that were coalesced to bigger packetss with the HW-GRO "
"netdevice feature. LRO-coalesced packets are not counted."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:482
msgid "rx-hw-gro-wire-bytes (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:482
msgid "See `rx-hw-gro-wire-packets`."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:486
msgid "rx-hw-drop-ratelimits (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:486
msgid ""
"Number of the packets dropped by the device due to the received packets "
"bitrate exceeding the device rate limit."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:492
msgid "tx-hw-drops (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:492
msgid ""
"Number of packets that arrived at the device but never left it, encompassing "
"packets dropped for reasons such as processing errors, as well as those "
"affected by explicitly defined policies and packet filtering criteria."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:500
msgid "tx-hw-drop-errors (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:500
msgid "Number of packets dropped because they were invalid or malformed."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:504
msgid "tx-csum-none (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:504
msgid ""
"Number of packets that did not require the device to calculate the checksum."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:510
msgid "tx-needs-csum (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:510
msgid ""
"Number of packets that required the device to calculate the checksum. This "
"counter includes the number of GSO wire packets for which device calculated "
"the L4 checksum."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:517
msgid "tx-hw-gso-packets (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:517
msgid ""
"Number of packets that necessitated segmentation into smaller packets by the "
"device."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:523
msgid "tx-hw-gso-bytes (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:523
msgid "See `tx-hw-gso-packets`."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:527
msgid "tx-hw-gso-wire-packets (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:527
msgid ""
"Number of wire-sized packets generated by processing `tx-hw-gso-packets`"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:533
msgid "tx-hw-gso-wire-bytes (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:533
msgid "See `tx-hw-gso-wire-packets`."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:537
msgid "tx-hw-drop-ratelimits (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:537
msgid ""
"Number of the packets dropped by the device due to the transmit packets "
"bitrate exceeding the device rate limit."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:543
msgid "tx-stop (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:543
msgid ""
"Number of times driver paused accepting new tx packets from the stack to "
"this queue, because the queue was full. Note that if BQL is supported and "
"enabled on the device the networking stack will avoid queuing a lot of data "
"at once."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:551
msgid "tx-wake (``uint``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:551
msgid ""
"Number of times driver re-started accepting send requests to this queue from "
"the stack."
msgstr ""

