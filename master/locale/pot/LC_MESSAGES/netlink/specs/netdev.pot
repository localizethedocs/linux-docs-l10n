msgid "type (``u32``)"
msgstr ""

#: ../../../netlink/specs/netdev.yaml:332
msgid ""
"Queue type as rx, tx. Each queue type defines a separate ID space. XDP TX "
"queues allocated in the kernel are not linked to NAPIs and thus not listed. "
"AF_XDP queues will have more information set in the xsk attribute."
msgstr ""

#: ../../../netlink/specs/netdev.yaml:332
#: ../../../netlink/specs/netdev.yaml:388
