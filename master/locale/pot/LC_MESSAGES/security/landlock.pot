msgid "Tests"
msgstr ""

#: ../../../security/landlock.rst:136
msgid ""
"Userspace tests for backward compatibility, ptrace restrictions and "
"filesystem support can be found here: `tools/testing/selftests/landlock/`_."
msgstr ""

