#: ../../../userspace-api/landlock:38: ../include/uapi/linux/landlock.h:159
#: ../../../userspace-api/landlock:612: ../security/landlock/syscalls.c:501
msgid "``LANDLOCK_RESTRICT_SELF_LOG_NEW_EXEC_ON``"
