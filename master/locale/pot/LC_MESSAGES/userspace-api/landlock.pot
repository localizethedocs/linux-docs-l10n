#: ../../../userspace-api/landlock:38: ../include/uapi/linux/landlock.h:167
#: ../../../userspace-api/landlock:612: ../security/landlock/syscalls.c:502
msgid "``LANDLOCK_RESTRICT_SELF_LOG_SUBDOMAINS_OFF``"
msgstr ""

#: ../../../userspace-api/landlock:38: ../include/uapi/linux/landlock.h:183
#: ../../../userspace-api/landlock:612: ../security/landlock/syscalls.c:503
msgid "``LANDLOCK_RESTRICT_SELF_TSYNC``"
msgstr ""

#: ../../../userspace-api/landlock:612: ../security/landlock/syscalls.c:505
msgid ""
"This system call enforces a Landlock ruleset on the current thread. "
"Enforcing a ruleset requires that the task has ``CAP_SYS_ADMIN`` in its "
"namespace or is running with no_new_privs.  This avoids scenarios where "
"unprivileged tasks can affect the behavior of privileged children."
msgstr ""

#: ../../../userspace-api/landlock:612: ../security/landlock/syscalls.c:512
msgid "``EINVAL``: **flags** contains an unknown bit."
msgstr ""

#: ../../../userspace-api/landlock:612: ../security/landlock/syscalls.c:513
