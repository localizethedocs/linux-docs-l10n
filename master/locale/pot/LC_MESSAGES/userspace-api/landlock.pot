msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:31
#: ../../../userspace-api/landlock:605: ../include/uapi/linux/landlock.h:232
#: ../include/uapi/linux/landlock.h:255
msgid "**Members**"
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:52
msgid "``handled_access_fs``"
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:53
msgid "Bitmask of handled filesystem actions (cf. `Filesystem flags`_)."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:57
msgid "``handled_access_net``"
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:58
msgid "Bitmask of handled network actions (cf. `Network flags`_)."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:62
msgid "``scoped``"
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:63
msgid ""
"Bitmask of scopes (cf. `Scope flags`_) restricting a Landlock domain from "
"accessing outside resources (e.g. IPCs)."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:68
msgid "``quiet_access_fs``"
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:69
msgid ""
"Bitmask of filesystem actions which should not be logged if per-object quiet "
"flag is set."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:73
msgid "``quiet_access_net``"
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:74
msgid ""
"Bitmask of network actions which should not be logged if per-object quiet "
"flag is set."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:78
msgid "``quiet_scoped``"
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:79
msgid "Bitmask of scoped actions which should not be logged."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:17
msgid "Argument of sys_landlock_create_ruleset()."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:19
msgid ""
"This structure defines a set of *handled access rights*, a set of actions on "
"different object types, which should be denied by default when the ruleset "
"is enacted.  Vice versa, access rights that are not specifically listed here "
"are not going to be denied by this ruleset when it is enacted."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:24
msgid ""
"For historical reasons, the ``LANDLOCK_ACCESS_FS_REFER`` right is always "
"denied by default, even when its bit is not set in **handled_access_fs**.  "
"In order to add new rules with this access right, the bit must still be set "
"explicitly (cf. `Filesystem flags`_)."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:29
msgid ""
"The explicit listing of *handled access rights* is required for backwards "
"compatibility reasons.  In most use cases, processes that use Landlock will "
"*handle* a wide range or all access rights that they know about at build "
"time (and that they have tested with a kernel that supported them all)."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:34
msgid ""
"**quiet_access_fs** and **quiet_access_net** are bitmasks of actions for "
"which a denial by this layer will not trigger a log if the corresponding "
"object (or its children, for filesystem rules) is marked with the \"quiet\" "
"bit via ``LANDLOCK_ADD_RULE_QUIET``, even if logging would normally take "
"place per landlock_restrict_self() flags.  **quiet_scoped** is similar, "
"except that it does not require marking any objects as quiet - if the "
"ruleset is created with any bits set in **quiet_scoped**, then denial of "
"such scoped resources will not trigger any log.  These 3 fields are "
"available since Landlock ABI version 10."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:44
msgid ""
"**quiet_access_fs**, **quiet_access_net** and **quiet_scoped** must be a "
"subset of **handled_access_fs**, **handled_access_net** and **scoped** "
"respectively."
msgstr ""

#: ../../../userspace-api/landlock:596: ../include/uapi/linux/landlock.h:47
msgid "This structure can grow in future Landlock versions."
msgstr ""

