#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:518
msgid "EINVAL"
msgstr ""

#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:519
msgid ""
"The struct :c:type:`v4l2_ext_control` ``id`` is invalid, or the struct :c:"
"type:`v4l2_ext_controls` ``which`` is invalid, or the struct :c:type:"
"`v4l2_ext_control` ``value`` was inappropriate (e.g. the given menu index is "
"not supported by the driver), or the ``which`` field was set to "
"``V4L2_CTRL_WHICH_REQUEST_VAL`` but the given ``request_fd`` was invalid or "
"``V4L2_CTRL_WHICH_REQUEST_VAL`` is not supported by the kernel. This error "
"code is also returned by the :ref:`VIDIOC_S_EXT_CTRLS <VIDIOC_G_EXT_CTRLS>` "
"and :ref:`VIDIOC_TRY_EXT_CTRLS <VIDIOC_G_EXT_CTRLS>` ioctls if two or more "
"control values are in conflict."
msgstr ""

#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:531
msgid "ERANGE"
msgstr ""

#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:532
msgid "The struct :c:type:`v4l2_ext_control` ``value`` is out of bounds."
msgstr ""

#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:535
msgid "EBUSY"
msgstr ""

#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:536
msgid ""
"The control is temporarily not changeable, possibly because another "
"applications took over control of the device function this control belongs "
"to, or (if the ``which`` field was set to ``V4L2_CTRL_WHICH_REQUEST_VAL``) "
"the request was queued but not yet completed."
msgstr ""

#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:542
msgid "ENOSPC"
msgstr ""

#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:543
msgid ""
"The space reserved for the control's payload is insufficient. The field "
"``size`` is set to a value that is enough to store the payload and this "
"error code is returned."
msgstr ""

#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:547
msgid "EACCES"
msgstr ""

#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:548
msgid ""
"Attempt to try or set a read-only control, or to get a write-only control, "
"or to get a control from a request that has not yet been completed."
msgstr ""

#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:552
msgid ""
"Or the ``which`` field was set to ``V4L2_CTRL_WHICH_REQUEST_VAL`` but the "
"device does not support requests."
msgstr ""

#: ../../../userspace-api/media/v4l/vidioc-g-ext-ctrls.rst:555
msgid ""
"Or if there is an attempt to set an inactive control and the driver is not "
"capable of caching the new value until the control is active again."
msgstr ""
