msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2660
msgid "Indicates bit rate for hierarchical coding layer 2 for HEVC encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2662
msgid "``V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_L3_BR (integer)``"
msgstr ""

