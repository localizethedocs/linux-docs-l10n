msgid "Indicates bit rate for hierarchical coding layer 3 for HEVC encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2665
msgid "``V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_L4_BR (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2666
msgid "Indicates bit rate for hierarchical coding layer 4 for HEVC encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2668
msgid "``V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_L5_BR (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2669
msgid "Indicates bit rate for hierarchical coding layer 5 for HEVC encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2671
msgid "``V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_L6_BR (integer)``"
msgstr ""

