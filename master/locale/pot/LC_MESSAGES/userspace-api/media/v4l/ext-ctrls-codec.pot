msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1335
msgid "``V4L2_CID_MPEG_VIDEO_VBV_SIZE (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1336
msgid ""
"The Video Buffer Verifier size in kilobytes, it is used as a limitation of "
"frame skip. The VBV is defined in the standard as a mean to verify that the "
"produced stream will be successfully decoded. The standard describes it as "
"\"Part of a hypothetical decoder that is conceptually connected to the "
"output of the encoder. Its purpose is to provide a constraint on the "
"variability of the data rate that an encoder or editing process may produce."
"\". Applicable to the MPEG1, MPEG2, MPEG4 encoders."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1347
msgid "``V4L2_CID_MPEG_VIDEO_VBV_DELAY (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1348
msgid "Sets the initial delay in milliseconds for VBV buffer control."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1352
msgid "``V4L2_CID_MPEG_VIDEO_MV_H_SEARCH_RANGE (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1353
msgid ""
"Horizontal search range defines maximum horizontal search area in pixels to "
"search and match for the present Macroblock (MB) in the reference picture. "
"This V4L2 control macro is used to set horizontal search range for motion "
"estimation module in video encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1360
msgid "``V4L2_CID_MPEG_VIDEO_MV_V_SEARCH_RANGE (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1361
msgid ""
"Vertical search range defines maximum vertical search area in pixels to "
"search and match for the present Macroblock (MB) in the reference picture. "
"This V4L2 control macro is used to set vertical search range for motion "
"estimation module in video encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1368
msgid "``V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME (button)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1369
msgid ""
"Force a key frame for the next queued buffer. Applicable to encoders. This "
"is a general, codec-agnostic keyframe control."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1374
msgid "``V4L2_CID_MPEG_VIDEO_H264_CPB_SIZE (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1375
msgid ""
"The Coded Picture Buffer size in kilobytes, it is used as a limitation of "
"frame skip. The CPB is defined in the H264 standard as a mean to verify that "
"the produced stream will be successfully decoded. Applicable to the H264 "
"encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1380
msgid "``V4L2_CID_MPEG_VIDEO_H264_I_PERIOD (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1381
msgid ""
"Period between I-frames in the open GOP for H264. In case of an open GOP "
"this is the period between two I-frames. The period between IDR "
"(Instantaneous Decoding Refresh) frames is taken from the GOP_SIZE control. "
"An IDR frame, which stands for Instantaneous Decoding Refresh is an I-frame "
"after which no prior frames are referenced. This means that a stream can be "
"restarted from an IDR frame without the need to store or decode any previous "
"frames. Applicable to the H264 encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1392
msgid "``V4L2_CID_MPEG_VIDEO_HEADER_MODE``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1395
msgid "enum v4l2_mpeg_video_header_mode -"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1396
msgid ""
"Determines whether the header is returned as the first buffer or is it "
"returned together with the first frame. Applicable to encoders. Possible "
"values are:"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1410
msgid "``V4L2_MPEG_VIDEO_HEADER_MODE_SEPARATE``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1411
msgid "The stream header is returned separately in the first buffer."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1412
msgid "``V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1413
msgid "The stream header is returned together with the first encoded frame."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1421
msgid "``V4L2_CID_MPEG_VIDEO_REPEAT_SEQ_HEADER (boolean)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1422
msgid ""
"Repeat the video sequence headers. Repeating these headers makes random "
"access to the video stream easier. Applicable to the MPEG1, 2 and 4 encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1426
msgid "``V4L2_CID_MPEG_VIDEO_DECODER_MPEG4_DEBLOCK_FILTER (boolean)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1427
msgid ""
"Enabled the deblocking post processing filter for MPEG4 decoder. Applicable "
"to the MPEG4 decoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1430
msgid "``V4L2_CID_MPEG_VIDEO_MPEG4_VOP_TIME_RES (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1431
msgid ""
"vop_time_increment_resolution value for MPEG4. Applicable to the MPEG4 "
"encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1434
msgid "``V4L2_CID_MPEG_VIDEO_MPEG4_VOP_TIME_INC (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1435
msgid "vop_time_increment value for MPEG4. Applicable to the MPEG4 encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1438
msgid "``V4L2_CID_MPEG_VIDEO_H264_SEI_FRAME_PACKING (boolean)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1439
msgid ""
"Enable generation of frame packing supplemental enhancement information in "
"the encoded bitstream. The frame packing SEI message contains the "
"arrangement of L and R planes for 3D viewing. Applicable to the H264 encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1444
msgid "``V4L2_CID_MPEG_VIDEO_H264_SEI_FP_CURRENT_FRAME_0 (boolean)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1445
msgid ""
"Sets current frame as frame0 in frame packing SEI. Applicable to the H264 "
