#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1122
msgid "``V4L2_MPEG_VIDEO_H264_LOOP_FILTER_MODE_DISABLED_AT_SLICE_BOUNDARY``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1123
#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2527
msgid "Loop filter is disabled at the slice boundary."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1130
msgid "``V4L2_CID_MPEG_VIDEO_H264_LOOP_FILTER_ALPHA (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1131
msgid ""
"Loop filter alpha coefficient, defined in the H264 standard. This value "
"corresponds to the slice_alpha_c0_offset_div2 slice header field, and should "
"be in the range of -6 to +6, inclusive. The actual alpha offset "
"FilterOffsetA is twice this value. Applicable to the H264 encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1137
msgid "``V4L2_CID_MPEG_VIDEO_H264_LOOP_FILTER_BETA (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1138
msgid ""
"Loop filter beta coefficient, defined in the H264 standard. This corresponds "
"to the slice_beta_offset_div2 slice header field, and should be in the range "
"of -6 to +6, inclusive. The actual beta offset FilterOffsetB is twice this "
"value. Applicable to the H264 encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1146
msgid "``V4L2_CID_MPEG_VIDEO_H264_ENTROPY_MODE``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1149
msgid "enum v4l2_mpeg_video_h264_entropy_mode -"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1150
msgid ""
"Entropy coding mode for H264 - CABAC/CAVALC. Applicable to the H264 encoder. "
"Possible values are:"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1161
msgid "``V4L2_MPEG_VIDEO_H264_ENTROPY_MODE_CAVLC``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1162
msgid "Use CAVLC entropy coding."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1163
msgid "``V4L2_MPEG_VIDEO_H264_ENTROPY_MODE_CABAC``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1164
msgid "Use CABAC entropy coding."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1168
msgid "``V4L2_CID_MPEG_VIDEO_H264_8X8_TRANSFORM (boolean)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1169
msgid "Enable 8X8 transform for H264. Applicable to the H264 encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1171
msgid "``V4L2_CID_MPEG_VIDEO_H264_CONSTRAINED_INTRA_PREDICTION (boolean)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1172
msgid ""
"Enable constrained intra prediction for H264. Applicable to the H264 encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1175
msgid "``V4L2_CID_MPEG_VIDEO_H264_CHROMA_QP_INDEX_OFFSET (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1176
msgid ""
"Specify the offset that should be added to the luma quantization parameter "
"to determine the chroma quantization parameter. Applicable to the H264 "
"encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1180
msgid "``V4L2_CID_MPEG_VIDEO_CYCLIC_INTRA_REFRESH_MB (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1181
msgid ""
"Cyclic intra macroblock refresh. This is the number of continuous "
"macroblocks refreshed every frame. Each frame a successive set of "
"macroblocks is refreshed until the cycle completes and starts from the top "
"of the frame. Setting this control to zero means that macroblocks will not "
"be refreshed.  Note that this control will not take effect when "
"``V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD`` control is set to non zero "
"value. Applicable to H264, H263 and MPEG4 encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1190
msgid "``V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE (enum)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1192
msgid "enum v4l2_mpeg_video_intra_refresh_period_type -"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1193
msgid ""
"Sets the type of intra refresh. The period to refresh the whole frame is "
"specified by V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD. Note that if this "
"control is not present, then it is undefined what refresh type is used and "
"it is up to the driver to decide. Applicable to H264 and HEVC encoders. "
"Possible values are:"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1205
msgid "``V4L2_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE_RANDOM``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1206
msgid ""
"The whole frame is completely refreshed randomly after the specified period."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1208
msgid "``V4L2_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE_CYCLIC``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1209
msgid ""
"The whole frame MBs are completely refreshed in cyclic order after the "
"specified period."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1212
msgid "``V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1213
msgid ""
"Intra macroblock refresh period. This sets the period to refresh the whole "
"frame. In other words, this defines the number of frames for which the whole "
"frame will be intra-refreshed.  An example: setting period to 1 means that "
"the whole frame will be refreshed, setting period to 2 means that the half "
"of macroblocks will be intra-refreshed on frameX and the other half of "
"macroblocks will be refreshed in frameX + 1 and so on. Setting the period to "
"zero means no period is specified. Note that if the client sets this control "
"to non zero value the ``V4L2_CID_MPEG_VIDEO_CYCLIC_INTRA_REFRESH_MB`` "
"control shall be ignored. Applicable to H264 and HEVC encoders."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1225
msgid "``V4L2_CID_MPEG_VIDEO_FRAME_RC_ENABLE (boolean)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1226
msgid ""
"Frame level rate control enable. If this control is disabled then the "
"quantization parameter for each frame type is constant and set with "
"appropriate controls (e.g. ``V4L2_CID_MPEG_VIDEO_H263_I_FRAME_QP``). If "
"frame rate control is enabled then quantization parameter is adjusted to "
"meet the chosen bitrate. Minimum and maximum value for the quantization "
"parameter can be set with appropriate controls (e.g. "
"``V4L2_CID_MPEG_VIDEO_H263_MIN_QP``). Applicable to encoders."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1235
msgid "``V4L2_CID_MPEG_VIDEO_MB_RC_ENABLE (boolean)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1236
msgid ""
"Macroblock level rate control enable. Applicable to the MPEG4 and H264 "
"encoders."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1239
msgid "``V4L2_CID_MPEG_VIDEO_MPEG4_QPEL (boolean)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1240
msgid ""
"Quarter pixel motion estimation for MPEG4. Applicable to the MPEG4 encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:1243
