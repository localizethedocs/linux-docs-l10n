msgid "Indicates bit rate for hierarchical coding layer 6 for HEVC encoder."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2674
msgid "``V4L2_CID_MPEG_VIDEO_REF_NUMBER_FOR_PFRAMES (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2675
msgid ""
"Selects number of P reference pictures required for HEVC encoder. P-Frame "
"can use 1 or 2 frames for reference."
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2678
msgid "``V4L2_CID_MPEG_VIDEO_PREPEND_SPSPPS_TO_IDR (integer)``"
msgstr ""

#: ../../../userspace-api/media/v4l/ext-ctrls-codec.rst:2679
msgid ""
"Indicates whether to generate SPS and PPS at every IDR. Setting it to 0 "
"disables generating SPS and PPS at every IDR. Setting it to one enables "
"generating SPS and PPS at every IDR."
msgstr ""
