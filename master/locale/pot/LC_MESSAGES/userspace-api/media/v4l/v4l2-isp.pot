msgstr ""

#: ../../../userspace-api/media/v4l/v4l2-isp:90:
#: ../include/uapi/linux/media/v4l2-isp.h:29
#: ../include/uapi/linux/media/v4l2-isp.h:63
#: ../include/uapi/linux/media/v4l2-isp.h:85
#: ../include/uapi/linux/media/v4l2-isp.h:98
#: ../include/uapi/linux/media/v4l2-isp.h:130
msgid "**Description**"
msgstr ""

#: ../../../userspace-api/media/v4l/v4l2-isp:90:
#: ../include/uapi/linux/media/v4l2-isp.h:21
msgid ""
"V0 and V1 are identical in order to support drivers compatible with the V4L2 "
"ISP format already upstreamed which use either 0 or 1 as their versioning "
"identifier. Both V0 and V1 refers to the first version of the V4L2 ISP "
"serialization format."
msgstr ""

#: ../../../userspace-api/media/v4l/v4l2-isp:90:
#: ../include/uapi/linux/media/v4l2-isp.h:26
msgid ""
"Future revisions of the V4L2 ISP serialization format should start from the "
"value of 2."
msgstr ""

