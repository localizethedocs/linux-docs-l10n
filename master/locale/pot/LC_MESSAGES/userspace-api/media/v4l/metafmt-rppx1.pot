msgid ""
"The RPP-X1 linearization module is available on the PRE1 and PRE2 pre-fusion "
"pipes. Userspace selects which pipe to operate by setting the **header."
"type** field to RPPX1_PARAMS_BLOCK_TYPE_LIN_PRE1 or "
"RPPX1_PARAMS_BLOCK_TYPE_LIN_PRE2."
msgstr ""

#: ../../../userspace-api/media/v4l/metafmt-rppx1:99:
#: ../include/uapi/linux/media/dreamchip/rppx1-config.h:579
msgid ""
"The LIN module applies the per-color channel de-gamma linearization curves "
"**curve_r**, **curve_g** and **curve_b** defined on the input sampling "
"points **dx**."
msgstr ""

#: ../../../userspace-api/media/v4l/metafmt-rppx1:99:
#: ../include/uapi/linux/media/dreamchip/rppx1-config.h:582
msgid ""
"For the PRE1 pipe the de-gamma curves values are 24-bits, for the PRE2 pipe "
"the de-gamma curve values are 12-bits."
msgstr ""

#: ../../../userspace-api/media/v4l/metafmt-rppx1:99:
#: ../include/uapi/linux/media/dreamchip/rppx1-config.h:585
msgid ""
"For the PRE1 pipe de-gamma module sampling points **dx** values are in the "
"range [0, 15] (4 bits). For the PRE2 pipe de-gamma module sampling points "
"values are in the range [0, 7] (3 bits)."
msgstr ""

#: ../../../userspace-api/media/v4l/metafmt-rppx1:99:
#: ../include/uapi/linux/media/dreamchip/rppx1-config.h:589
