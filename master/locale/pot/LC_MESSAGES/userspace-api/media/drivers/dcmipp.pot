msgid "ST DCMIPP driver"
msgstr ""

#: ../../../userspace-api/media/drivers/dcmipp.rst:6
msgid ""
"The ST DCMIPP driver implements a driver specific control as part of its "
"pixelproc subdev."
msgstr ""

#: ../../../userspace-api/media/drivers/dcmipp.rst:9
msgid "``V4L2_CID_DCMIPP_PIXELPROC_GAMMA_CORRECTION_ENABLE (boolean)``"
msgstr ""

#: ../../../userspace-api/media/drivers/dcmipp.rst:10
msgid "Enable / disable the gamma correction block."
msgstr ""

#: ../../../userspace-api/media/drivers/dcmipp.rst:12
msgid ""
"The DCMIPP PixelProc stage implements a gamma compression on each R, G, B "
"component, using a static gamma exponent 2.2. The gamma is implemented as a "
"7-segment linear curve."
msgstr ""
