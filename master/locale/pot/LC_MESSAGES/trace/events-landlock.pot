#: ../include/trace/events/landlock.h:810
#: ../include/trace/events/landlock.h:882
#: ../include/trace/events/landlock.h:933
#: ../include/trace/events/landlock.h:984
msgid "The domain's audit-logging decision for this denial."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:746
#: ../include/trace/events/landlock.h:812
msgid "``const struct landlock_blockers *blockers``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:745
#: ../include/trace/events/landlock.h:811
msgid "Request type and final missing access subset (never NULL)."
msgstr ""

