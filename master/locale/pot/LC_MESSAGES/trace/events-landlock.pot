#: ../../../trace/events-landlock:355: ../include/trace/events/landlock.h:1141
msgid "``const struct task_struct *target``"
msgstr ""

#: ../../../trace/events-landlock:355: ../include/trace/events/landlock.h:1140
msgid ""
"The task the signal was aimed at (never NULL).  target_pid is the init-"
"namespace TGID (like audit's opid)."
msgstr ""

#: ../../../trace/events-landlock:355: ../include/trace/events/landlock.h:1143
msgid "``int signal``"
msgstr ""

#: ../../../trace/events-landlock:355: ../include/trace/events/landlock.h:1142
msgid ""
"The signal selected by the denied check.  Zero is a permission probe, not an "
"absent value."
msgstr ""

#: ../../../trace/events-landlock:355: ../include/trace/events/landlock.h:1144
msgid ""
"Emitted when a Landlock domain denies signal delivery to a scoped-out target."
msgstr ""

#: ../../../trace/events-landlock:355: ../include/trace/events/landlock.h:1182
msgid ""
"Abstract unix socket access denied by LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET"
msgstr ""

#: ../../../trace/events-landlock:355: ../include/trace/events/landlock.h:1190
msgid "``u64 peer_domain_id``"
msgstr ""

#: ../../../trace/events-landlock:355: ../include/trace/events/landlock.h:1189
msgid "The peer's Landlock domain ID, or 0 if the peer is unsandboxed."
msgstr ""

#: ../../../trace/events-landlock:355: ../include/trace/events/landlock.h:1192
msgid "``const struct sock *peer``"
msgstr ""

#: ../../../trace/events-landlock:355: ../include/trace/events/landlock.h:1191
msgid ""
"Peer socket (never NULL).  peer_pid is best-effort: it is 0 for a datagram "
"peer (no SO_PEERCRED), so sun_path is the reliable peer identifier."
msgstr ""

#: ../../../trace/events-landlock:355: ../include/trace/events/landlock.h:1194
msgid ""
"Emitted when a Landlock domain denies access to a scoped-out abstract unix "
"socket."
msgstr ""

