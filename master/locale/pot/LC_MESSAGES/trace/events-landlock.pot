msgid "Filesystem path that was denied (never NULL)."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:747
msgid ""
"Resolved path string (never NULL; an error placeholder on resolution "
"failure)."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:749
msgid "Emitted when a Landlock domain denies a filesystem access."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:805
msgid "Network access denied"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:813
msgid "``const struct sock *sk``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:812
msgid ""
"Socket object (never NULL), read without a socket lock, so its fields are a "
"best-effort snapshot."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:815
msgid "``u16 socket_family``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:814
msgid "Socket-family snapshot used by the verdict."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:816
msgid "``const struct sockaddr_storage *address``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:815
msgid ""
"Authoritative address checked by the verdict (never NULL). The producer "
"copies **addrlen** bytes from the checked address and zeroes the remaining "
"storage before emission.  The :c:type:`sockaddr_in.sin_port <sockaddr_in>` "
"or :c:type:`sockaddr_in6.sin6_port <sockaddr_in6>` member, when present, "
"remains in network endianness."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:821
msgid "``int addrlen``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:820
msgid "Validated signed length of **address**."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:821
msgid ""
"Emitted when a Landlock domain denies a network operation.  The blocker "
"identifies whether the address is a bind or connect/send policy object. The "
"flattened port field is converted from the checked address to host "
"endianness, or is -1 when no port was checked.  Zero is a valid checked port."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:877
msgid "Ptrace access denied by a Landlock domain"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:881
msgid "Whether the tracer entered the denying domain itself."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:884
msgid "``u64 tracee_domain_id``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:883
msgid "The tracee's Landlock domain ID, or 0 if the tracee is unsandboxed."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:886
msgid "``const struct task_struct *tracee``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:885
msgid ""
"The target task ptrace acted on (never NULL).  tracee_pid is the init-"
"namespace TGID (like audit's opid)."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:888
msgid "``const struct task_struct *tracer``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:887
msgid ""
"The tracer or proposed tracer (never NULL); for PTRACE_TRACEME this is the "
"parent, not the syscall caller."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:889
msgid "Emitted when a Landlock domain denies a ptrace operation."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:927
msgid "Signal delivery denied by LANDLOCK_SCOPE_SIGNAL"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:932
msgid "Whether the policy subject entered the denying domain itself."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:935
msgid "``u64 target_domain_id``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:934
msgid "The target's Landlock domain ID, or 0 if the target is unsandboxed."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:937
msgid "``const struct task_struct *target``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:936
msgid ""
"The task the signal was aimed at (never NULL).  target_pid is the init-"
"namespace TGID (like audit's opid)."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:939
msgid "``int signal``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:938
msgid ""
"The signal selected by the denied check.  Zero is a permission probe, not an "
"absent value."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:940
msgid ""
"Emitted when a Landlock domain denies signal delivery to a scoped-out target."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:978
msgid ""
"Abstract unix socket access denied by LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:986
msgid "``u64 peer_domain_id``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:985
msgid "The peer's Landlock domain ID, or 0 if the peer is unsandboxed."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:988
msgid "``const struct sock *peer``"
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:987
msgid ""
"Peer socket (never NULL).  peer_pid is best-effort: it is 0 for a datagram "
"peer (no SO_PEERCRED), so sun_path is the reliable peer identifier."
msgstr ""

#: ../../../trace/events-landlock:323: ../include/trace/events/landlock.h:990
msgid ""
"Emitted when a Landlock domain denies access to a scoped-out abstract unix "
"socket."
msgstr ""

