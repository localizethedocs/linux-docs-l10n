#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:340
msgid "Filesystem rule added to a ruleset"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:342
#: ../include/trace/events/landlock.h:396
msgid "Source ruleset (never NULL)."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:344
#: ../include/trace/events/landlock.h:398
msgid "``access_mask_t access_rights``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:343
#: ../include/trace/events/landlock.h:397
msgid ""
"Effective access mask stored in the rule, not the raw "
"sys_landlock_add_rule() argument (unhandled rights added)."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:347
#: ../include/trace/events/landlock.h:682
msgid "``const struct path *path``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:346
msgid "Filesystem path for the rule (never NULL)."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:348
#: ../include/trace/events/landlock.h:683
msgid "``const char *pathname``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:347
msgid ""
"Resolved absolute path string (never NULL; error placeholder on resolution "
"failure)."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:349
#: ../include/trace/events/landlock.h:402
msgid ""
"Emitted by sys_landlock_add_rule() under the modified ruleset's lock, so the "
"reported ruleset is a stable snapshot that no concurrent writer can change."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:394
msgid "Network port rule added to a ruleset"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:401
#: ../include/trace/events/landlock.h:632
msgid "``__u64 port``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:400
msgid ""
"Network port, the landlock_net_port_attr.port UAPI value forwarded directly."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:436
msgid "New domain created"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:442
#: ../include/trace/events/landlock.h:489
#: ../include/trace/events/landlock.h:582
#: ../include/trace/events/landlock.h:632
msgid "``const struct landlock_domain *domain``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:438
msgid ""
"Newly created domain (never NULL, immutable after creation). **domain-"
">hierarchy->id** is its unique ID, shared with the landlock_enforce_domain "
"and landlock_free_domain events; **domain->hierarchy->details** holds the "
"requesting process."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:442
msgid ""
"Source ruleset frozen into the domain (never NULL).  The ruleset lock is "
"held across the emission, so a BPF program reading it via BTF sees the exact "
"merged ruleset; **ruleset->id** / **ruleset->version** identify it."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:446
msgid ""
"Emitted by sys_landlock_restrict_self() once, in the requesting thread's "
"context, right after the merge and before thread-sync.  The flags-only path "
"(ruleset_fd == -1) creates no domain and does not emit this event.  Paired "
"with the per-thread landlock_enforce_domain (join on **domain->hierarchy-"
">id**) and balanced by a matching landlock_free_domain event."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:483
msgid "Domain enforced on a thread"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:485
msgid ""
"Domain now enforced on the current thread (never NULL, immutable; read "
"locklessly).  Correlate to landlock_create_domain via **domain->hierarchy-"
">id** for the source ruleset and requesting thread, or read **domain-"
">hierarchy->details** for the requesting process."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:491
msgid "``bool complete``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:490
msgid ""
"Set on the single event that concludes the operation, after all its other "
"enforcements; filter on it for one event per operation."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:494
msgid "``bool process_wide``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:493
msgid ""
"The enforcement covers every eligible (non-exiting) thread of the process: "
"set when the caller used ``LANDLOCK_RESTRICT_SELF_TSYNC`` or the process is "
"single-threaded.  A lone thread whose group still holds a zombie leader is "
"not counted single-threaded, so process_wide == 0 never proves the opposite."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:500
msgid "``bool no_new_privs``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:499
msgid ""
"The enforcing thread's no_new_privs state at enforcement time: 1 if set (by "
"a prior :manpage:`prctl(2)` ``PR_SET_NO_NEW_PRIVS`` or by "
"``LANDLOCK_RESTRICT_SELF_NO_NEW_PRIVS``), 0 if the domain was enforced with "
"``CAP_SYS_ADMIN`` instead."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:504
msgid ""
"Emitted for each thread sys_landlock_restrict_self() enforces the domain on, "
"in that thread's own context, right after its commit_creds(), so it fires "
"only once the thread is irreversibly enforcing the domain (aborted "
"operations emit none).  Not balanced; every enforcement falls between the "
"domain's landlock_create_domain and landlock_free_domain events."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:511
msgid ""
"**complete** == 1 && **process_wide** == 1 means the whole process is "
"sandboxed by **domain**, durably (Landlock domains are monotonic and "
"inherited on :manpage:`clone(2)`)."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:543
msgid "Domain freed"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:549
#: ../include/trace/events/landlock.h:679
#: ../include/trace/events/landlock.h:736
#: ../include/trace/events/landlock.h:793
#: ../include/trace/events/landlock.h:840
#: ../include/trace/events/landlock.h:889
msgid "``const struct landlock_hierarchy *hierarchy``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:545
msgid "Hierarchy node being freed (never NULL)."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:546
msgid ""
"Emitted when the hierarchy node's last reference is dropped: its refcount "
"reaches zero after all child domains have released their parent reference.  "
"A committed domain is freed from a kworker via "
"landlock_put_domain_deferred() (the credential free path runs in RCU "
"context, where sleeping is forbidden), so the current task is not the "
"sandboxed task that triggered the free.  Balanced by a matching "
"landlock_create_domain event."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:576
msgid "Filesystem rule evaluated during access check"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:578
#: ../include/trace/events/landlock.h:628
msgid "Enforcing domain (never NULL)."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:580
#: ../include/trace/events/landlock.h:630
msgid "``const struct landlock_rule *rule``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:579
#: ../include/trace/events/landlock.h:629
msgid "Matching rule with per-layer access masks (never NULL)."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:581
#: ../include/trace/events/landlock.h:631
msgid "``access_mask_t access_request``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:580
msgid ""
"Access mask evaluated against the rule (the domain's handled mask during "
"rename/link double-checks)."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:583
msgid "``const struct dentry *dentry``"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:582
msgid "Filesystem dentry being checked (never NULL)."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:583
msgid ""
"Emitted for each rule that matches during a filesystem access check. The "
"grants array shows the requested rights the rule grants at each domain "
"layer.  See Documentation/trace/events-landlock.rst for how to interpret it."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:626
msgid "Network port rule evaluated during access check"
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:630
msgid "Access mask being requested."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:631
msgid "Network port being checked (host endianness)."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:632
msgid ""
"Emitted for each rule that matches during a network access check.  The "
"grants array shows the requested rights the rule grants at each domain "
"layer.  See Documentation/trace/events-landlock.rst for how to interpret it."
msgstr ""

#: ../../../trace/events-landlock:317: ../include/trace/events/landlock.h:673
msgid "Filesystem access denied"
msgstr ""

