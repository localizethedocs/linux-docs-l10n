#: ../../../block/error-injection.rst:5
msgid "Configurable Error Injection"
msgstr ""

#: ../../../block/error-injection.rst:8
msgid "Overview"
msgstr ""

#: ../../../block/error-injection.rst:10
msgid ""
"Configurable error injection allows injecting delays and/or specific block "
"layer status codes for sector ranges of a block device by adding rules.  The "
"rules can be configured to trigger unconditionally, or with a given "
"probability."
msgstr ""

#: ../../../block/error-injection.rst:14
msgid ""
"To use configurable error injection, CONFIG_BLK_ERROR_INJECTION must be "
"enabled."
msgstr ""

#: ../../../block/error-injection.rst:16
msgid ""
"The only interface is the error_injection debugfs file, which is created for "
"each registered gendisk.  Writes to this file are used to create or delete "
"rules and reads return a list of the current error injection sites."
msgstr ""

#: ../../../block/error-injection.rst:21
msgid "Options"
msgstr ""

#: ../../../block/error-injection.rst:23
msgid "The following options specify the operations:"
msgstr ""

#: ../../../block/error-injection.rst:26
msgid "add"
msgstr ""

#: ../../../block/error-injection.rst:26
msgid "add a new rule"
msgstr ""

#: ../../../block/error-injection.rst:27
msgid "removeall"
msgstr ""

#: ../../../block/error-injection.rst:27
msgid "remove all existing rules"
msgstr ""

#: ../../../block/error-injection.rst:30
msgid ""
"The following options specify the details of the rule for the add operation:"
msgstr ""

#: ../../../block/error-injection.rst:33
msgid "op=<string>"
msgstr ""

#: ../../../block/error-injection.rst:33
msgid ""
"block layer operation this rule applies to.  This uses the XYZ for each "
"REQ_OP_XYZ operation, e.g. READ, WRITE or DISCARD. Mandatory."
msgstr ""

#: ../../../block/error-injection.rst:36
msgid "status=<string>"
msgstr ""

#: ../../../block/error-injection.rst:36
msgid ""
"Status to return.  This uses XYZ for each BLK_STS_XYZ code, e.g. IOERR or "
"MEDIUM.  Mandatory unless delay_us is given."
msgstr ""

#: ../../../block/error-injection.rst:39
msgid "start=<number>"
msgstr ""

#: ../../../block/error-injection.rst:39
msgid "First block layer sector the rule applies to. Optional, defaults to 0."
msgstr ""

#: ../../../block/error-injection.rst:41
msgid "nr_sectors=<number>"
msgstr ""

#: ../../../block/error-injection.rst:41
msgid ""
"Number of sectors this rule applies. Optional, defaults to the remainder of "
"the device."
msgstr ""

#: ../../../block/error-injection.rst:43
msgid "chance=<number>"
msgstr ""

#: ../../../block/error-injection.rst:43
msgid ""
"Only apply the rule with a likelihood of 1/chance. Optional, defaults to 1 "
"(always)."
msgstr ""

#: ../../../block/error-injection.rst:45
msgid "delay_us=<number>"
msgstr ""

#: ../../../block/error-injection.rst:45
msgid ""
"Hold the bio back for this many microseconds.  Without status the bio is "
"then submitted to the device as usual.  With status it is failed once the "
"delay has expired.  Bios with REQ_NOWAIT set fail with BLK_STS_AGAIN.  "
"Optional, defaults to 0 (no delay). Values above 600 seconds are rejected."
msgstr ""

#: ../../../block/error-injection.rst:54
msgid "Delays"
msgstr ""

#: ../../../block/error-injection.rst:56
msgid ""
"A delayed bio is held above the driver, so the device never sees a slow I/O. "
"A delay does not reach the blk-mq timeout handler or SCSI error handling."
msgstr ""

#: ../../../block/error-injection.rst:59
msgid ""
"A bio that matched a delay rule is not evaluated against the rules again, "
"even after it is split and resubmitted internally.  Removing a rule does not "
"release bios it is already delaying."
msgstr ""

#: ../../../block/error-injection.rst:63
msgid ""
"Holding a bio back reorders it against bios submitted later.  On zoned "
"devices this breaks sequential write ordering and the block layer fails the "
"out-of-order writes, so only delay reads there."
msgstr ""

#: ../../../block/error-injection.rst:68
msgid "Example"
msgstr ""

#: ../../../block/error-injection.rst:70
msgid "Return BLK_STS_IOERR for one in 10 reads of sector 0 of /dev/nvme0n1:"
msgstr ""

#: ../../../block/error-injection.rst:72
msgid ""
"$ echo 'add,op=READ,start=0,status=IOERR,chance=10' > /sys/kernel/debug/"
"block/nvme0n1/error_injection"
msgstr ""

#: ../../../block/error-injection.rst:74
msgid "Return BLK_STS_MEDIUM for every write to /dev/nvme0n1:"
msgstr ""

#: ../../../block/error-injection.rst:76
msgid ""
"$ echo 'add,op=WRITE,start=0,status=MEDIUM' > /sys/kernel/debug/block/"
"nvme0n1/error_injection"
msgstr ""

#: ../../../block/error-injection.rst:78
msgid ""
"Delay every read of /dev/nvme0n1 by 10 milliseconds, then issue it normally:"
msgstr ""

#: ../../../block/error-injection.rst:80
msgid ""
"$ echo 'add,op=READ,delay_us=10000' > /sys/kernel/debug/block/nvme0n1/"
"error_injection"
msgstr ""

#: ../../../block/error-injection.rst:82
msgid "Fail one in 100 writes with BLK_STS_TIMEOUT, but only after 30 seconds:"
msgstr ""

#: ../../../block/error-injection.rst:84
msgid ""
"$ echo 'add,op=WRITE,status=TIMEOUT,chance=100,delay_us=30000000' > /sys/"
"kernel/debug/block/nvme0n1/error_injection"
msgstr ""

#: ../../../block/error-injection.rst:86
msgid "Remove all rules for /dev/nvme0n1:"
msgstr ""

#: ../../../block/error-injection.rst:88
msgid "$ echo 'removeall' > /sys/kernel/debug/block/nvme0n1/error_injection"
msgstr ""
