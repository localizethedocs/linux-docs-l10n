msgstr ""

#: ../../../gpu/amdgpu/flashing:33:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_psp.c:5181
msgid "**PTL sysfs attributes**"
msgstr ""

#: ../../../gpu/amdgpu/flashing:33:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_psp.c:5183
msgid ""
"These sysfs files under /sys/class/drm/cardX/device/ptl allow users to "
"enable or disable the Peak Tops Limiter (PTL), configure preferred PTL data "
"formats, and query supported formats for each GPU."
msgstr ""

#: ../../../gpu/amdgpu/flashing:33:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_psp.c:5190
msgid "**psp_vbflash**"
msgstr ""

#: ../../../gpu/amdgpu/flashing:33:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_psp.c:5301
msgid ""
"Writing to this file will stage an IFWI for update. Reading from this file "
"will trigger the update process."
msgstr ""

#: ../../../gpu/amdgpu/flashing:33:
