msgid "**ptl (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1169
msgid "Enable PTL feature at boot time. Possible values:"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1172
msgid "0 = disable PTL (default)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1173
msgid "1 = enable PTL"
msgstr ""

