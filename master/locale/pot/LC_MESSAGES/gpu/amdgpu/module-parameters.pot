#: ../../../gpu/amdgpu/module-parameters.rst:3
msgid "Module Parameters"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters.rst:5
msgid "The amdgpu driver supports the following module parameters:"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:3
msgid "**vramlimit (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:282
msgid ""
"Restrict the total amount of VRAM in MiB for testing.  The default is 0 (Use "
"full VRAM)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:287
msgid "**vis_vramlimit (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:289
msgid ""
"Restrict the amount of CPU visible VRAM in MiB for testing.  The default is "
"0 (Use full CPU visible VRAM)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:294
msgid "**gartsize (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:296
msgid ""
"Restrict the size of GART (for kernel use) in Mib (32, 64, etc.) for "
"testing. The default is -1 (The size depends on asic)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:302
msgid "**gttsize (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:304
msgid ""
"Restrict the size of GTT domain (for userspace use) in MiB for testing. The "
"default is -1 (Use value specified by TTM). This parameter is deprecated and "
"will be removed in the future."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:311
msgid "**moverate (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:313
msgid "Set maximum buffer migration rate in MB/s. The default is -1 (8 MB/s)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:318
msgid "**audio (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:320
msgid ""
"Set HDMI/DPAudio. Only affects non-DC display handling. The default is -1 "
"(Enabled), set 0 to disabled it."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:325
msgid "**disp_priority (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:327
msgid ""
"Set display Priority (1 = normal, 2 = high). Only affects non-DC display "
"handling. The default is 0 (auto)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:332
msgid "**hw_i2c (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:334
msgid ""
"To enable hw i2c engine. Only affects non-DC display handling. The default "
"is 0 (Disabled)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:339
msgid "**pcie_gen2 (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:341
msgid ""
"To disable PCIE Gen2/3 mode (0 = disable, 1 = enable). The default is -1 "
"(auto, enabled)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:346
msgid "**msi (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:348
msgid ""
"To disable Message Signaled Interrupts (MSI) functionality (1 = enable, 0 = "
"disable). The default is -1 (auto, enabled)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:353
msgid "**svm_default_granularity (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:355
msgid "Used in buffer migration and handling of recoverable page faults"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:360
msgid "**lockup_timeout (string)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:362
msgid "Set GPU scheduler timeout value in ms."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:364
msgid ""
"The format can be [single value] for setting all timeouts at once or "
"[GFX,Compute,SDMA,Video] to set individual timeouts. Negative values mean "
"infinity."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:368
msgid ""
"By default(with no lockup_timeout settings), the timeout for all queues is "
"2000."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:373
msgid "**dpm (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:377
msgid ""
"Override for dynamic power management setting (0 = disable, 1 = enable) The "
"default is -1 (auto)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:384
msgid "**fw_load_type (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:386
msgid ""
"Set different firmware loading type for debugging, if supported. Set to 0 to "
"force direct loading if supported by the ASIC.  Set to -1 to select the "
"default loading mode for the ASIC, as defined by the driver.  The default is "
"-1 (auto)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:394
msgid "**aspm (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:396
msgid ""
"To disable ASPM (1 = enable, 0 = disable). The default is -1 (auto, enabled)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:401
msgid "**iommu_perfopt (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:403
msgid ""
"Control the AMD IOMMU PerfOpt DMA-latency optimization (0 = disable; -1 = "
"enable on supported devices). This arms the IOMMU PerfOpt control (IOMMU "
"spec, MMIO Offset 016Ch, EFR PerfOptSup / PerfOptEn) Arming it disables ATS, "
"PRI, PASID and SVA for the GPU and removes IOMMU DMA containment for it, "
"trading isolation for lower DMA latency."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:412
msgid "**runpm (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:414
msgid ""
"Override for runtime power management control for dGPUs. The amdgpu driver "
"can dynamically power down the dGPUs when they are idle if supported. The "
"default is -1 (auto enable). Setting the value to 0 disables this "
"functionality. Setting the value to -2 is auto enabled with power down when "
"displays are attached."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:422
msgid "**ip_block_mask (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:424
msgid ""
"Override what IP blocks are enabled on the GPU. Each GPU is a collection of "
"IP blocks (gfx, display, video, etc.). Use this parameter to disable "
"specific blocks. Note that the IP blocks do not have a fixed index. Some "
"asics may not have some IPs or may include multiple instances of an IP so "
"the ordering various from asic to asic. See the driver output in the kernel "
"log for the list of IPs on the asic. The default is 0xffffffff (enable all "
"blocks on a device)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:432
msgid "**bapm (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:434
msgid ""
"Bidirectional Application Power Management (BAPM) used to dynamically share "
"TDP between CPU and GPU. Set value 0 to disable it. The default -1 (auto, "
"enabled)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:440
msgid "**deep_color (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:442
msgid ""
"Set 1 to enable Deep Color support. Only affects non-DC display handling. "
"The default is 0 (disabled)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:447
msgid "**vm_size (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:449
msgid ""
"Override the size of the GPU's per client virtual address space in GiB.  The "
"default is -1 (automatic for each asic)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:454
msgid "**vm_fragment_size (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:456
msgid ""
"Override VM fragment size in bits (4, 5, etc. 4 = 64K, 9 = 2M). The default "
"is -1 (automatic for each asic)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:461
msgid "**vm_block_size (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:463
msgid ""
"Override VM page table size in bits (default depending on vm_size and hw "
"setup). The default is -1 (automatic for each asic)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:468
msgid "**vm_fault_stop (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:470
msgid ""
"Stop on VM fault for debugging (0 = never, 1 = print first, 2 = always). The "
"default is 0 (No stop)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:475
msgid "**vm_update_mode (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:477
msgid ""
"Override VM update mode. VM updated by using CPU (0 = never, 1 = Graphics "
"only, 2 = Compute only, 3 = Both). The default is -1 (Only in large BAR(LB) "
"systems Compute VM tables will be updated by CPU, otherwise 0, never)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:483
msgid "**exp_hw_support (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:485
msgid ""
"Enable experimental hw support (1 = enable). The default is 0 (disabled)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:490
msgid "**dc (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:492
msgid ""
"Disable/Enable Display Core driver for debugging (1 = enable, 0 = disable). "
"The default is -1 (automatic for each asic)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:497
msgid "**sched_jobs (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:499
msgid ""
"Override the max number of jobs supported in the sw queue. The default is 32."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:504
msgid "**sched_hw_submission (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:506
msgid "Override the max number of HW submissions. The default is 2."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:511
msgid "**ppfeaturemask (hexint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:513
msgid ""
"Override power features enabled. See enum PP_FEATURE_MASK in drivers/gpu/drm/"
"amd/include/amd_shared.h. The default is the current set of stable power "
"features."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:519
msgid "**forcelongtraining (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:521
msgid ""
"Force long memory training in resume. The default is zero, indicates short "
"training in resume."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:527
msgid "**pcie_gen_cap (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:529
msgid ""
"Override PCIE gen speed capabilities. See the CAIL flags in drivers/gpu/drm/"
"amd/include/amd_pcie.h. The default is 0 (automatic for each asic)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:535
msgid "**pcie_lane_cap (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:537
msgid ""
"Override PCIE lanes capabilities. See the CAIL flags in drivers/gpu/drm/amd/"
"include/amd_pcie.h. The default is 0 (automatic for each asic)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:543
msgid "**cg_mask (ullong)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:545
msgid ""
"Override Clockgating features enabled on GPU (0 = disable clock gating). See "
"the AMD_CG_SUPPORT flags in drivers/gpu/drm/amd/include/amd_shared.h. The "
"default is 0xffffffffffffffff (all enabled)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:551
msgid "**pg_mask (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:553
msgid ""
"Override Powergating features enabled on GPU (0 = disable power gating). See "
"the AMD_PG_SUPPORT flags in drivers/gpu/drm/amd/include/amd_shared.h. The "
"default is 0xffffffff (all enabled)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:559
msgid "**sdma_phase_quantum (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:561
msgid ""
"Override SDMA context switch phase quantum (x 1K GPU clock cycles, 0 = no "
"change). The default is 32."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:566
msgid "**disable_cu (charp)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:568
msgid "Set to disable CUs (It's set like se.sh.cu,...). The default is NULL."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:573
msgid "**virtual_display (charp)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:575
msgid ""
"Set to enable virtual display feature. This feature provides a virtual "
"display hardware on headless boards or in virtualized environments. It will "
"be set like xxxx:xx:xx.x,x;xxxx:xx:xx.x,x. It's the pci address of the "
"device, plus the number of crtcs to expose. E.g., 0000:26:00.0,4 would "
"enable 4 virtual crtcs on the pci device at 26:00.0. The default is NULL."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:583
msgid "**lbpw (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:586
msgid ""
"Override Load Balancing Per Watt (LBPW) support (1 = enable, 0 = disable). "
"The default is -1 (auto, enabled)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:591
msgid "**gpu_recovery (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:596
msgid ""
"Set to enable GPU recovery mechanism (1 = enable, 0 = disable). The default "
"is -1 (auto, disabled except SRIOV)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:601
msgid "**emu_mode (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:603
msgid ""
"Set value 1 to enable emulation mode. This is only needed when running on an "
"emulator. The default is 0 (disabled)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:608
msgid "**ras_enable (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:610
msgid ""
"Enable RAS features on the GPU (0 = disable, 1 = enable, -1 = auto (default))"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:615
msgid "**ras_mask (ullong)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:617
msgid ""
"Mask of RAS features to enable (default 0xffffffffffffffff), only valid when "
"ras_enable == 1 See the flags in drivers/gpu/drm/amd/amdgpu/amdgpu_ras.h"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:623
msgid "**timeout_fatal_disable (bool)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:625
msgid "Disable Watchdog timeout fatal error event"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:630
msgid "**timeout_period (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:632
msgid "Modify the watchdog timeout max_cycles as (1 << period)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:637
msgid "**si_support (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:639
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:657
msgid "1 = enabled, 0 = disabled, -1 = default"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:641
msgid ""
"SI (Southern Islands) are first generation GCN GPUs, supported by both "
"drivers: radeon (old) and amdgpu (new). This parameter controls whether "
"amdgpu should support SI. By default, SI dedicated GPUs are supported by "
"amdgpu. Only relevant when CONFIG_DRM_AMDGPU_SI is enabled to build SI "
"support in amdgpu. See also radeon.si_support which should be disabled when "
"amdgpu.si_support is enabled, and vice versa."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:652
msgid "**cik_support (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:659
msgid ""
"CIK (Sea Islands) are second generation GCN GPUs, supported by both drivers: "
"radeon (old) and amdgpu (new). This parameter controls whether amdgpu should "
"support CIK. By default, CIK dedicated GPUs and APUs are supported by "
"amdgpu. Only relevant when CONFIG_DRM_AMDGPU_CIK is enabled to build CIK "
"support in amdgpu. See also radeon.cik_support which should be disabled when "
"amdgpu.cik_support is enabled, and vice versa."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:670
msgid "**smu_memory_pool_size (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:675
msgid ""
"It is used to reserve gtt for smu debug usage, setting value 0 to disable "
"it. The actual size is value * 256MiB. E.g. 0x1 = 256Mbyte, 0x2 = 512Mbyte, "
"0x4 = 1 Gbyte, 0x8 = 2GByte. The default is 0 (disabled)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:681
msgid "**async_gfx_ring (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:684
msgid ""
"It is used to enable gfx rings that could be configured with different "
"prioritites or equal priorities"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:689
msgid "**mcbp (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:692
msgid ""
"It is used to enable mid command buffer preemption. (0 = disabled, 1 = "
"enabled, -1 auto (default))"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:697
msgid "**discovery (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:700
msgid ""
"Allow driver to discover hardware IP information from IP Discovery table at "
"the top of VRAM. (-1 = auto (default), 0 = disabled, 1 = enabled, 2 = use "
"ip_discovery table from file)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:706
msgid "**mes_log_enable (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:709
msgid ""
"Enable Micro Engine Scheduler log. This is used to enable/disable MES "
"internal log. (0 = disabled (default), 1 = enabled)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:715
msgid "**mes_dbgext_buffer_size (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:718
msgid ""
"Size in KB of the MES firmware debug-extension log buffer. The MES firmware "
"writes log messages into this buffer and the driver drains and prints them "
"to dmesg. Requires an MES firmware image built with debug extension support. "
"(0 = disabled at boot (default))"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:723
msgid ""
"The feature can also be toggled at runtime via the per-device debugfs file "
"<debugfs>/dri/N/amdgpu_mes_dbgext (echo 1/0 to enable/disable); when enabled "
"at runtime with this parameter left at 0, a small default buffer is used."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:730
msgid "**mes_dbgext_options (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:733
msgid ""
"MES firmware debug-extension option bits sent to the firmware (u64_all). "
"bit0 = trigger_interrupt_per_new_msg: when set, the firmware raises an "
"interrupt per message and the driver collects them via the interrupt path; "
"when clear, the driver polls the log buffer with a kthread instead. (default "
"1 = interrupt driven)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:742
msgid "**uni_mes (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:745
msgid ""
"Enable Unified Micro Engine Scheduler. This is a new engine pipe for unified "
"scheduler. (0 = disabled (default), 1 = enabled)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:751
msgid "**noretry (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:754
msgid ""
"Disable XNACK retry in the SQ by default on GFXv9 hardware. On ASICs that do "
"not support per-process XNACK this also disables retry page faults. (0 = "
"retry enabled, 1 = retry disabled, -1 auto (default))"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:761
msgid "**force_asic_type (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:764
msgid ""
"A non negative value used to specify the asic type for all supported GPUs."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:769
msgid "**use_xgmi_p2p (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:772
msgid "Enables/disables XGMI P2P interface (0 = disable, 1 = enable)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:777
msgid "**sched_policy (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:782
msgid ""
"Set scheduling policy. Default is HWS(hardware scheduling) with over-"
"subscription. Setting 1 disables over-subscription. Setting 2 disables HWS "
"and statically assigns queues to HQDs."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:789
msgid "**hws_max_conc_proc (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:793
msgid ""
"Maximum number of processes that HWS can schedule concurrently. The maximum "
"is the number of VMIDs assigned to the HWS, which is also the default."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:799
msgid "**cwsr_enable (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:803
msgid ""
"CWSR(compute wave store and resume) allows the GPU to preempt shader "
"execution in the middle of a compute wave. Default is 1 to enable this "
"feature. Setting 0 disables it as only in non-HWS mode."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:810
msgid "**max_num_of_queues_per_device (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:813
msgid ""
"Maximum number of queues per device. Valid setting is between 1 and 4096. "
"Default is 4096."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:819
msgid "**send_sigterm (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:823
msgid ""
"Send sigterm to HSA process on unhandled exceptions. Default is not to send "
"sigterm but just print errors on dmesg. Setting 1 enables sending sigterm."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:829
msgid "**halt_if_hws_hang (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:833
msgid ""
"Halt if HWS hang is detected. Default value, 0, disables the halt on hang. "
"Setting 1 enables halt on hang."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:839
msgid "**hws_gws_support(bool)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:842
msgid ""
"Assume that HWS supports GWS barriers regardless of what firmware version "
"check says. Default value: false (rely on MEC2 firmware version check)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:848
msgid "**queue_preemption_timeout_ms (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:851
msgid "queue preemption timeout in ms (1 = Minimum, 9000 = default)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:856
msgid "**debug_evictions(bool)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:859
msgid "Enable extra debug messages to help determine the cause of evictions"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:864
msgid "**no_system_mem_limit(bool)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:867
msgid "Disable system memory limit, to support multiple process shared memory"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:872
msgid "**no_queue_eviction_on_vm_fault (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:875
msgid ""
"If set, process queues will not be evicted on gpuvm fault. This is to keep "
"the wavefront context for debugging (0 = queue eviction, 1 = no queue "
"eviction). The default is 0 (queue eviction)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:880
msgid "**mtype_local (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:889
msgid "**mtype_remote (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:896
msgid "**pcie_p2p (bool)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:898
msgid "Enable PCIe P2P (requires large-BAR). Default value: true (on)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:903
msgid "**dcfeaturemask (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:908
msgid ""
"Override display features enabled. See enum DC_FEATURE_MASK in drivers/gpu/"
"drm/amd/include/amd_shared.h. The default is the current set of stable "
"display features."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:914
msgid "**dcdebugmask (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:916
msgid ""
"Display debug options. See enum DC_DEBUG_MASK in drivers/gpu/drm/amd/include/"
"amd_shared.h."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:921
msgid "**abmlevel (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:926
msgid ""
"Override the default ABM (Adaptive Backlight Management) level used for DC "
"enabled hardware. Requires DMCU to be supported and loaded. Valid levels are "
"0-4. A value of 0 indicates that ABM should be disabled by default. Values "
"1-4 control the maximum allowable brightness reduction via the ABM "
"algorithm, with 1 being the least reduction and 4 being the most reduction."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:933
msgid ""
"Defaults to -1, or auto. Userspace can only override this level after boot "
"if it's set to auto."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:939
msgid "**damageclips (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:947
msgid ""
"Enable or disable damage clips support. If damage clips support is disabled, "
"we will force full frame updates, irrespective of what user space sends to "
"us."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:951
msgid ""
"Defaults to -1 (where it is enabled unless a PSR-SU display is detected)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:956
msgid "**tmz (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:959
msgid ""
"Trusted Memory Zone (TMZ) is a method to protect data being written to or "
"read from memory."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:962
msgid "The default value: 0 (off).  TODO: change to auto till it is completed."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:967
msgid "**freesync_video (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:969
msgid ""
"Enable the optimization to adjust front porch timing to achieve seamless "
"mode change experience when setting a freesync supported mode for which full "
"modeset is not needed."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:973
msgid ""
"The Display Core will add a set of modes derived from the base FreeSync "
"video mode into the corresponding connector's mode list based on commonly "
"used refresh rates and VRR range of the connected display, when users enable "
"this feature. From the userspace perspective, they can see a seamless mode "
"change experience when the change between different refresh rates under the "
"same resolution. Additionally, userspace applications such as Video playback "
"can read this modeset list and change the refresh rate based on the video "
"frame rate. Finally, the userspace can also derive an appropriate mode for a "
"particular refresh rate based on the FreeSync Mode and add it to the "
"connector's mode list."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:984
msgid "Note: This is an experimental feature."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:986
msgid "The default value: 0 (off)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:991
msgid "**reset_method (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:995
msgid ""
"GPU reset method (-1 = auto (default), 0 = legacy, 1 = mode0, 2 = mode1, 3 = "
"mode2, 4 = baco)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1000
msgid "**bad_page_threshold (int) Bad page threshold is specifies the**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1002
msgid ""
"threshold value of faulty pages detected by RAS ECC, which may result in the "
"GPU entering bad status when the number of total faulty pages by ECC exceeds "
"the threshold value."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1009
msgid "**vcnfw_log (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1014
msgid "Enable vcnfw log output for debugging, the default is disabled."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1019
msgid "**sg_display (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1021
msgid ""
"Disable S/G (scatter/gather) display (i.e., display from system memory). "
"This option is only relevant on APUs.  Set this option to 0 to disable S/G "
"display if you experience flickering or other issues under memory pressure "
"and report the issue."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1029
msgid "**umsch_mm (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1031
msgid ""
"Enable Multi Media User Mode Scheduler. This is a HW scheduling engine for "
"VCN and VPE. (0 = disabled (default), 1 = enabled)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1037
msgid "**umsch_mm_fwlog (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1040
msgid "Enable umschfw log output for debugging, the default is disabled."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1045
msgid "**smu_pptable_id (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1047
msgid ""
"Used to override pptable id. id = 0 use VBIOS pptable. id > 0 use the soft "
"pptable with specicfied id."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1053
msgid "**partition_mode (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1056
msgid "Used to override the default SPX mode."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1061
msgid "**enforce_isolation (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1071
msgid ""
"enforce process isolation between graphics and compute. (-1 = auto, 0 = "
"disable, 1 = enable, 2 = enable legacy mode, 3 = enable without cleaner "
"shader)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1077
msgid "**modeset (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1080
msgid "Override nomodeset (1 = override, -1 = auto). The default is -1 (auto)."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1085
msgid "**seamless (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1087
msgid ""
"Seamless boot will keep the image on the screen during the boot process."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1092
msgid "**debug_mask (uint)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1094
msgid ""
"Debug options for amdgpu, work as a binary mask with the following options:"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1096
msgid "0x1: Debug VM handling"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1097
msgid ""
"0x2: Enable simulating large-bar capability on non-large bar system. This "
"limits the VRAM size reported to ROCm applications to the visible size, "
"usually 256MB."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1100
msgid "0x4: Disable GPU soft recovery, always do a full reset"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1101
msgid "0x8: Use VRAM for firmware loading"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1102
msgid "0x10: Enable ACA based RAS logging"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1103
msgid "0x20: Enable experimental resets"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1104
msgid "0x40: Disable ring resets"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1105
msgid "0x80: Use VRAM for SMU pool"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1110
msgid "**agp (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1112
msgid ""
"Enable the AGP aperture.  This provides an aperture in the GPU's internal "
"address space for direct access to system memory.  Note that these accesses "
"are non-snooped, so they are only used for access to uncached memory."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1119
msgid "**wbrf (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1121
msgid ""
"Enable Wifi RFI interference mitigation feature. Due to electrical and "
"mechanical constraints there may be likely interference of relatively high-"
"powered harmonics of the (G-)DDR memory clocks with local radio module "
"frequency bands used by Wifi 6/6e/7. To mitigate the possible RFI "
"interference, with this feature enabled, PMFW will use either “shadowed P-"
"State” or “P-State” based on active list of frequencies in-use (to be "
"avoided) as part of initial setting or P-state transition. However, there "
"may be potential performance impact with this feature enabled. (0 = "
"disabled, 1 = enabled, -1 = auto (default setting, will be enabled if "
"supported))"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1134
msgid "**rebar (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1137
msgid ""
"Allow BAR resizing.  Disable this to prevent the driver from attempting to "
"resize the BAR if the GPU supports it and there is available MMIO space. "
"Note that this just prevents the driver from resizing the BAR.  The BIOS may "
"have already resized the BAR at boot time."
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1145
msgid "**user_queue (int)**"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1147
msgid ""
"Enable user queues on systems that support user queues. Possible values:"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1149
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1171
msgid "-1 = auto (ASIC specific default)"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1150
msgid "0 = user queues disabled"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1151
msgid "1 = user queues enabled and kernel queues enabled (if supported)"
