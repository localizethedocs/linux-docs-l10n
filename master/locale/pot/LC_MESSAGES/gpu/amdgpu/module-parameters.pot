#: ../../../gpu/amdgpu/module-parameters:7:
#: ../drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c:1152
msgid "2 = user queues enabled and kernel queues disabled"
msgstr ""

#: ../../../gpu/amdgpu/module-parameters:7:
