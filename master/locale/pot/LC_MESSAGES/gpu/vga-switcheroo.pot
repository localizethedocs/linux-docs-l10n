msgid "``pre_switch``"
msgstr ""

#: ../../../gpu/vga-switcheroo:40: ../include/linux/vga_switcheroo.h:138
msgid ""
"prepare switch Optional. This gets called before switching the outputs to "
"the GPU. Allows drivers to prepare for the switch."
msgstr ""

#: ../../../gpu/vga-switcheroo:40: ../include/linux/vga_switcheroo.h:140
msgid "``post_switch``"
msgstr ""

#: ../../../gpu/vga-switcheroo:40: ../include/linux/vga_switcheroo.h:141
msgid ""
"completes switch Optional. This gets called after waking the GPU and "
"switching the outputs to it. Allows drivers to poll the switched outputs."
msgstr ""

#: ../../../gpu/vga-switcheroo:40: ../include/linux/vga_switcheroo.h:143
msgid "``gpu_bound``"
msgstr ""

#: ../../../gpu/vga-switcheroo:40: ../include/linux/vga_switcheroo.h:144
msgid "notify the client id to audio client when the GPU is bound."
msgstr ""

#: ../../../gpu/vga-switcheroo:40: ../include/linux/vga_switcheroo.h:144
msgid ""
"Client callbacks. A client can be either a GPU or an audio device on a GPU. "
"The **set_gpu_state** and **can_switch** methods are mandatory, "
"**pre_switch** and **post_switch** may be set to NULL. For audio clients, "
"the **pre_switch** and **post_switch** members are bogus. OTOH, "
"**gpu_bound** is only for audio clients, and not used for GPU clients."
msgstr ""

