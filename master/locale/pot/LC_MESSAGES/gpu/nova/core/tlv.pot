#: ../../../gpu/nova/core/tlv.rst:5
msgid "TLV Tags in Nova Firmware Images"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:7
msgid ""
"Nova firmware images use a Type-Length-Value (TLV) format to encapsulate "
"firmware components and metadata. The TLV file begins with a 4-byte "
"\"magic\" header that contains the string \"NVFW\".  Following the header is "
"a sequence of TLV blocks."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:12
msgid ""
"Each block consists of a 4-byte tag of ASCII characters, a 4-byte length "
"encoded as a little-endian unsigned integer, and a sequence of bytes, the "
"size of which is equal to the length rounded up to the next multiple of 4."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:16
msgid ""
"The driver code that reads the TLV and uses its contents is called the "
"parser. It is the responsibility of the parser to handle missing or "
"malformed tags, lengths, and values in the TLV."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:47
msgid "Tags and Length"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:48
msgid ""
"TLV tags are always four-character words, with all letters being upper case. "
"Duplicate tags are not allowed."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:51
msgid "A TLV file may contain additional tags not described in this document."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:54
msgid "Values"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:55
msgid ""
"Values are one of four types.  The type is not encoded in the format; "
"rather, the parser expects a given tag to have a value of a given type."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:58
msgid "Integers, encoded in 32-bit or 64-bit little-endian format."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:59
msgid ""
"Strings, encoded as-is and required to be only printable ASCII characters "
"and without a null terminator."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:61
msgid "An array of bytes, for binary data."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:62
msgid ""
"Boolean, encoded as single byte, with a value of 0 for False or 1 for True."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:65
msgid "Common Tags"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:66
msgid ""
"These tags are shared across firmware types and carry the same meaning "
"wherever they appear.  Unlike the firmware-specific tags below, a common tag "
"is reserved: its meaning is fixed and may never be redefined for a "
"particular firmware type."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:71
msgid "``VERS`` (string)"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:72
msgid "Human-readable firmware version string.  Present in all TLV files."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:74
msgid ""
"A TLV image must contain either a single ``BLOB`` tag (firmware embedded "
"inline) or a ``SIZE``/``FILE`` pair (firmware stored in a separate file)."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:77
msgid "``BLOB`` (bytes)"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:78
msgid ""
"If the firmware microcode binary is stored in the TLV, this tag contains the "
"actual firmware image bytes."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:81
msgid "``FILE`` (string)"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:82
msgid ""
"If the firmware binary is stored as a separate file, this tag contains the "
"name of that file, which is required to be in the same directory as the TLV, "
"so no paths are allowed in the filename.  This tag is always paired with "
"``SIZE``, so as to allow the driver to pre-allocate the buffer before "
"loading the file."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:88
msgid "``SIZE`` (u32)"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:89
msgid ""
"Total size in bytes of the firmware image to be loaded from the companion "
"file named by ``FILE``.  This tag is mandatory if ``FILE`` exists, so the "
"size of the firmware image must be known when the TLV is created.  If the "
"firmware image is updated and its size changes, then the TLV must be updated "
"with it."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:96
msgid "GSP Firmware Tags"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:97 ../../../gpu/nova/core/tlv.rst:144
#: ../../../gpu/nova/core/tlv.rst:182
msgid "``SIGN`` (bytes)"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:98
msgid "Cryptographic signature for the GSP firmware."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:100
msgid "``BLID`` (string)"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:101
msgid "The build ID, extracted from the \".note.gnu.build-id\" section."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:104
msgid "Booter Firmware Tags"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:105
msgid "``DAOF`` (u32) - ``os_data_offset``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:106
msgid ""
"OS data section offset within the firmware image (absolute byte offset). "
"Maps to the DMEM load source."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:109
msgid "``DASZ`` (u32) - ``os_data_size``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:110
msgid "OS data section size in bytes."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:112
msgid "``CDOF`` (u32) - ``os_code_offset``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:113
msgid ""
"OS code section offset within the firmware image (absolute byte offset). "
"Maps to the non-secure IMEM load source."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:116
msgid "``CDSZ`` (u32) - ``os_code_size``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:117
msgid "OS code section size in bytes."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:119
msgid "``PLOC`` (u32) - ``patch_loc``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:120
msgid ""
"Signature patch location -- byte offset within the firmware image where the "
"selected signature should be written."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:123
msgid "``FUSE`` (u32) - ``fuse_version``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:124
msgid ""
"Fuse version of the firmware, used with the hardware fuse register to select "
"the correct signature index."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:127
msgid "``ENID`` (u32) - ``engine_id``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:128
msgid "Engine ID mask identifying the falcon engine this firmware targets."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:130
msgid "``UCID`` (u32) - ``ucode_id``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:131
msgid ""
"Microcode ID used together with the engine ID to query hardware signature "
"fuse registers."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:134
msgid "``A0CO`` (u32) - ``app0_code_offset``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:135
msgid ""
"App0 code offset -- start of the secure code region within the firmware "
"image. Used as the IMEM secure section source."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:138
msgid "``A0CS`` (u32) - ``app0_code_size``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:139
msgid "App0 code size in bytes."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:141
msgid "``NSIG`` (u32) - ``num_sigs``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:142
msgid "Number of signatures included in the ``SIGN`` tag."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:145
msgid ""
"Concatenated array of firmware signatures. The size of each signature is the "
"total length of the ``SIGN`` value divided by ``NSIG``. The correct "
"signature is selected using the fuse-version-derived index."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:150
msgid "Generic Bootloader Tags"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:151
msgid "``CDSZ`` (u32) - ``code_size``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:152
msgid ""
"Size in bytes of the bootloader code to copy from the ``BLOB`` tag and PIO-"
"load into falcon IMEM."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:155
msgid "``STRT`` (u32) - ``start_tag``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:156
msgid ""
"Start tag identifying the IMEM block where execution begins.  The falcon "
"boot address is derived as ``start_tag << 8``."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:160
msgid "GSP Bootloader Tags"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:161
msgid "``CDOF`` (u32) - ``code_offset``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:162
msgid "Offset within the firmware image at which the code section starts."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:164
msgid "``DAOF`` (u32) - ``data_offset``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:165
msgid "Offset within the firmware image at which the data section starts."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:167
msgid "``MFOF`` (u32) - ``manifest_offset``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:168
msgid "Offset within the firmware image at which the manifest starts."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:170
msgid "``APPV`` (u32) - ``app_version``"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:171
msgid "Application version of the firmware."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:174
msgid "FMC Firmware Tags"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:175
msgid "``HASH`` (bytes)"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:176
msgid "SHA-384 hash of the FMC firmware, exactly 48 bytes long."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:178
msgid "``PKEY`` (bytes)"
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:179
msgid ""
"Public key used to verify the FMC firmware. At most 384 bytes (RSA-3072), "
"but may be shorter."
msgstr ""

#: ../../../gpu/nova/core/tlv.rst:183
msgid ""
"Signature of the FMC firmware. At most 384 bytes (RSA-3072), but may be "
"shorter."
msgstr ""
