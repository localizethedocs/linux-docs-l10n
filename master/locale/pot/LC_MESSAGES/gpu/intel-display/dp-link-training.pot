#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:247
msgid "Transitions:"
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:108
msgid "A1 Link training succeeds."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:110
msgid ""
"A link check work to recover any degraded link is scheduled (and handled if "
"needed in context B)."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:113
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:175
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:250
msgid "State -> ``INTEL_DP_LINK_RECOVERY_IDLE``."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:115
msgid ""
"A2 First link training fails after initialization or a previously successful "
"link training."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:118
msgid ""
"An automatic retraining work is scheduled (and handled in context B) with "
"the same link parameters with which the link training failed."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:122
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:186
msgid "State -> ``INTEL_DP_LINK_RECOVERY_AUTORETRAIN_PENDING``."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:124
msgid "A3 Link training fails again after A2 or A3."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:126
msgid ""
"Through fallback selection, the driver attempts to restrict the allowed link "
"configurations for subsequent modesets. This may be done either by lowering "
"global limits (rate/lane caps), or by disabling only the currently failing "
"configuration while leaving all other configurations allowed, even if they "
"use higher rate or lane count."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:133
msgid ""
"(The current implementation may still apply parameter capping as a coarse "
"fallback selection mechanism. This is transitional and is expected to be "
"replaced by a scheme that disables only the failing configuration, rather "
"than removing configurations that have not been observed to fail and may "
"still train successfully.)"
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:139
msgid "This case may repeat in a loop:"
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:140
msgid ""
"``INTEL_DP_LINK_RECOVERY_AUTORETRAIN_DISABLED`` -> "
"``INTEL_DP_LINK_RECOVERY_AUTORETRAIN_DISABLED``"
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:143
msgid ""
"via repeated A3a -> A3a transitions until the configuration fallback space "
"is exhausted, reaching the A3b terminal case."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:146
msgid "A3a Fallback selection succeeds."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:148
msgid "Userspace is notified to retry the modeset."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:150
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:236
msgid "State -> ``INTEL_DP_LINK_RECOVERY_AUTORETRAIN_DISABLED``."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:152
msgid "A3b Fallback selection fails."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:154
msgid ""
"Userspace is notified of the failure and may continue recovery by retrying "
"the modeset with the remaining allowed link configuration."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:158
msgid "State -> ``INTEL_DP_LINK_RECOVERY_NO_FALLBACK``."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:160
msgid "Automatic retraining context:"
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:163
msgid ""
"after a successful link training in context A1 followed by asynchronous link "
"degradation, or"
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:165
msgid "after the first failed link training attempt in context A2, or"
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:166
msgid ""
"via the \"i915_dp_force_link_retrain\" debugfs entry, which may bypass "
"normal gating and force this path."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:170
msgid "B1 ``Autoretrain`` modeset check and link training succeeds."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:172
msgid ""
"The case is handled as in A1, scheduling a link check work to recover any "
"degraded link."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:177
msgid "B2 ``Autoretrain`` modeset check succeeds but link training fails."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:179
msgid ""
"B2a Previously the link degraded asynchronously (current state is "
"``INTEL_DP_LINK_RECOVERY_IDLE``)."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:182
msgid ""
"This corresponds to a first failure in a new failure sequence and is handled "
"as in A2: an automatic retraining attempt is scheduled with the same link "
"parameters."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:188
msgid ""
"B2b Previously a link training failed (current state is "
"``INTEL_DP_LINK_RECOVERY_AUTORETRAIN_PENDING``)."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:191
msgid ""
"In non-regular (debug-forced) scenarios this may also be reached from "
"``INTEL_DP_LINK_RECOVERY_AUTORETRAIN_DISABLED`` or "
"``INTEL_DP_LINK_RECOVERY_NO_FALLBACK``, effectively behaving like a "
"userspace-driven recovery attempt."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:197
msgid "The failure is handled as in A3, performing a fallback selection:"
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:199
msgid "State -> ``INTEL_DP_LINK_RECOVERY_AUTORETRAIN_DISABLED`` (via A3a)."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:201
msgid "or"
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:203
msgid "State -> ``INTEL_DP_LINK_RECOVERY_NO_FALLBACK`` (via A3b)."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:205
msgid ""
"B3 ``Autoretrain`` modeset check fails (and hence the link training cannot "
"be started)."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:208
msgid ""
"The modeset check may fail, for example, due to external conditions such as "
"changed shared link bandwidth, which can make previously valid modeset "
"parameters no longer acceptable."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:212
msgid ""
"In this case, automatic retraining is disabled without selecting a fallback "
"configuration. The driver hands recovery over to userspace without modifying "
"the allowed configuration set, so a subsequent userspace modeset will retry "
"with the current link configuration. Userspace is in a better position to "
"select new modeset parameters (e.g. video mode or enabled outputs) that "
"satisfy the updated constraints, as the driver is only allowed to retry the "
"modeset with the existing userspace-provided modeset configuration."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:222
msgid ""
"This policy preserves the normal retry model, where a given link "
"configuration is attempted twice in the automatic retraining flow before "
"being abandoned: after a first link training failure, an automatic "
"retraining modeset is performed with the same link parameters, and if its "
"atomic check passes, the link training itself may either succeed or fail, "
"constituting the second attempt. In this case, however, the retry modeset's "
"atomic check failed, so no second link training attempt with those "
"parameters was performed, and selecting a fallback would cause that "
"configuration to be tried only once rather than twice."
msgstr ""

#: ../../../gpu/intel-display/dp-link-training:7:
#: ../drivers/gpu/drm/i915/display/intel_dp_link_training.c:233
msgid ""
"The userspace-driven link recovery continues with subsequent userspace "
"modesets handled in A3."
msgstr ""

