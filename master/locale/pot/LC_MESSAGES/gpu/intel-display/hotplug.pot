msgstr ""

#: ../../../gpu/intel-display/hotplug:10:
#: ../drivers/gpu/drm/i915/display/intel_hotplug.c:574
msgid "a mask of hpd pins that have triggered the irq"
msgstr ""

#: ../../../gpu/intel-display/hotplug:10:
#: ../drivers/gpu/drm/i915/display/intel_hotplug.c:576
msgid "``u32 long_mask``"
msgstr ""

