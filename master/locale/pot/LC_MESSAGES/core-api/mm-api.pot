msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1006
msgid "Length of the range to monitor"
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1008
msgid "``const struct mmu_interval_notifier_ops *ops``"
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1008
msgid "Interval notifier operations to be called on matching events"
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1009
msgid ""
"This function subscribes the interval notifier for notifications from the "
"mm.  Upon return the ops related to mmu_interval_notifier will be called "
"whenever an event that intersects with the given range occurs."
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1013
msgid ""
"Upon return the range_notifier may not be present in the interval tree yet. "
"The caller must use the normal interval notifier read flow via "
"mmu_interval_read_begin() to establish SPTEs for this range."
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1076
msgid "Remove a interval notifier"
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1077
msgid "Interval subscription to unregister"
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1078
msgid ""
"This function must be paired with mmu_interval_notifier_insert(). It cannot "
"be called from any ops callback."
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1081
msgid ""
"Once this returns ops callbacks are no longer running on other CPUs and will "
"not be called in future."
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1130
msgid "Ensure all mmu_notifiers are freed"
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1131
msgid ""
"This function ensures that all outstanding async SRU work from "
"mmu_notifier_put() is completed. After it returns any mmu_notifier_ops "
"associated with an unused mmu_notifier will no longer be called."
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1135
msgid ""
"Before using the caller must ensure that all of its mmu_notifiers have been "
"fully released via mmu_notifier_put()."
msgstr ""

#: ../../../core-api/mm-api:145: ../mm/mmu_notifier.c:1138
msgid ""
"Modules using the mmu_notifier_put() API should call this in their __exit "
"function to avoid module unloading races."
msgstr ""

