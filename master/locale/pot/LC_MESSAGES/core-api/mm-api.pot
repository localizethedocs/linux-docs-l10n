msgid "``unsigned int extra_refs``"
msgstr ""

#: ../../../core-api/mm-api:121: ../mm/folio.c:888
msgid "Extra folio references held by the caller."
msgstr ""

#: ../../../core-api/mm-api:121: ../mm/folio.c:890
msgid "``enum lru_cache_drained *drained``"
msgstr ""

