#: ../../../core-api/mm-api:89: ../mm/page-writeback.c:2014
msgid "Balance dirty memory state."
msgstr ""

#: ../../../core-api/mm-api:89: ../mm/page-writeback.c:2015
#: ../mm/page-writeback.c:2090
