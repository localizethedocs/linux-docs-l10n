msgstr ""

#: ../../../core-api/mm-api:86: ../include/linux/pagemap.h:228
msgid "``int error``"
msgstr ""

#: ../../../core-api/mm-api:86: ../include/linux/pagemap.h:227
msgid "the error to set in the mapping"
msgstr ""

#: ../../../core-api/mm-api:86: ../include/linux/pagemap.h:233
msgid ""
"When a writeback error occurs, most filesystems will want to call "
"mapping_set_error to record the error in the mapping so that it can be "
"reported when the application calls fsync(2)."
msgstr ""

#: ../../../core-api/mm-api:86: ../include/linux/pagemap.h:445
