msgid "``linux/tools/power/cpupower``"
msgstr ""

#: ../../../core-api/real-time/kernel-configuration.rst:108
msgid "Documentation/admin-guide/pm/cpuidle.rst"
msgstr ""

#: ../../../core-api/real-time/kernel-configuration.rst:109
msgid "Documentation/admin-guide/pm/index.rst"
msgstr ""

#: ../../../core-api/real-time/kernel-configuration.rst:112
msgid "``CONFIG_DRM``"
msgstr ""

#: ../../../core-api/real-time/kernel-configuration.rst:117
msgid ""
"GPU-accelerated workloads can share system resources with the CPU, including "
"last-level cache (LLC) and memory bandwidth.  Modern integrated GPUs "
"optimize graphics performance at the expense of CPU determinism."
msgstr ""

#: ../../../core-api/real-time/kernel-configuration.rst:121
msgid "Examples of affected platforms:"
msgstr ""

