msgid "``unsigned int safety_coeff``"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:2020
msgid "multiplier applied over the theoretical wire time"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:2022
msgid "``unsigned int min_usec``"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:2021
msgid "minimum timeout floor in microseconds"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:2022
msgid ""
"Computes a transfer-specific timeout from the message length and bus "
"frequency, applies a safety multiplier and a minimum floor, then stores the "
"result in adap->timeout (in jiffies).  The caller supplies the policy "
"constants so they remain internal to the driver."
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:2027
msgid ""
"A timeout explicitly configured by userspace via the I2C_TIMEOUT ioctl "
"always takes precedence; the computed value is used only when userspace has "
"not configured one."
msgstr ""

