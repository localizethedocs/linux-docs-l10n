#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:1972
msgid "get I2C related timing parameters from firmware"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:1973
msgid "The device to scan for I2C timing properties"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:1975
msgid "``struct i2c_timings *t``"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:1974
msgid "the i2c_timings struct to be filled with values"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:1976
msgid "``bool use_defaults``"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:1975
msgid ""
"bool to use sane defaults derived from the I2C specification when properties "
"are not found, otherwise don't update"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:1977
msgid ""
"Scan the device for the generic I2C properties describing timing parameters "
"for the signal and fill the given struct with the results. If a property was "
"not found and use_defaults was true, then maximum timings are assumed which "
"are derived from the I2C specification. If use_defaults is not used, the "
"results will be as before, so drivers can apply their own defaults before "
"calling this helper. The latter is mainly intended for avoiding regressions "
"of existing drivers which want to switch to this function. New drivers "
"almost always should use the defaults."
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:2016
msgid "compute and set a dynamic transfer timeout on an adapter"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:2017
msgid "the i2c_adapter whose timeout field will be updated"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:2019
msgid "``u32 bus_freq_hz``"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:2018
msgid "I2C bus clock frequency in Hz"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:2020
msgid "``size_t len``"
msgstr ""

#: ../../../driver-api/i2c:44: ../drivers/i2c/i2c-core-base.c:2019
msgid "transfer length in bytes"
msgstr ""

