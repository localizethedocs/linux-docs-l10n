msgid "``fils_erp_realm_len``"
msgstr ""

#: ../../../driver-api/80211/cfg80211:48: ../include/net/cfg80211.h:3653
msgid "Length of **fils_erp_realm** in octets."
msgstr ""

#: ../../../driver-api/80211/cfg80211:48: ../include/net/cfg80211.h:3653
msgid "``fils_erp_next_seq_num``"
msgstr ""

#: ../../../driver-api/80211/cfg80211:48: ../include/net/cfg80211.h:3654
msgid ""
"The next sequence number to use in the FILS ERP messages. This is also used "
"to construct FILS wrapped data IE."
msgstr ""

#: ../../../driver-api/80211/cfg80211:48: ../include/net/cfg80211.h:3655
msgid "``fils_erp_rrk``"
msgstr ""

