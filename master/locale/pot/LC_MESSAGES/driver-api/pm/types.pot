msgid "Out-of-band wakeup is supported."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:697
msgid "``strict_midlayer``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:698
msgid ""
"Middle layer code does not want callbacks invoked via "
"pm_runtime_force_suspend() / pm_runtime_force_resume()."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:699
msgid "``should_wakeup``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:700
msgid "Wakeup flag when system sleep is not enabled."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:700
msgid "``suspend_timer``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:701
msgid ""
"High-resolution timer used for scheduling delayed runtime suspend and "
"autosuspend requests."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:702
msgid "``timer_expires``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:703
msgid "Timer expiration time in nanoseconds monotonic time (runtime PM)."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:704
msgid "``work``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:705
msgid "Work structure used for queuing up requests into pm_wq (runtime PM)."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:705
msgid "``wait_queue``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:706
msgid ""
"Wait queue used if any helper functions need to wait for another state "
"change to complete (runtime PM)."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:707
msgid "``wakeirq``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:708
msgid "Dedicated wakeup interrupt for the device."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:708
msgid "``usage_count``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:709
msgid "Device runtime PM usage counter."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:709
msgid "``child_count``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:710
msgid "Count of active children of the device (runtime PM)."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:710
msgid "``disable_depth``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:711
msgid ""
"Disable counter for runtime PM (runtime PM is enabled when this is 0; "
"initial value is 1)."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:712
msgid "``idle_notification``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:713
msgid "Set if ->runtime_idle() is being executed."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:713
msgid "``request_pending``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:714
msgid "Set if a work item is queued into pm_wq (runtime PM)."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:714
msgid "``deferred_resume``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:715
msgid ""
"Set if ->runtime_resume() should run as soon as ->runtime_suspend() "
"completes."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:716
msgid "``needs_force_resume``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:717
msgid ""
"Indicates the device was forced into suspend by pm_runtime_force_suspend() "
"and must be resumed by pm_runtime_force_resume()."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:719
msgid "``runtime_auto``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:720
msgid ""
"User space has allowed the driver to power manage the device at runtime via "
"sysfs control attribute; also can be set by pm_runtime_allow() or "
"pm_runtime_forbid()."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:722
msgid "``ignore_children``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:723
msgid ""
"If set, the value of child_count is ignored for runtime suspend and idle "
"decisions."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:724
msgid "``no_callbacks``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:725
msgid "Indicates the device does not use runtime PM callbacks."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:725
msgid "``irq_safe``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:726
msgid ""
"Indicates runtime PM callbacks will be invoked with the spinlock held and "
"interrupts disabled."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:727
msgid "``use_autosuspend``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:728
msgid "Indicates the device driver supports delayed runtime autosuspend."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:729
msgid "``timer_autosuspends``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:730
msgid ""
"Indicates the runtime PM core should attempt an autosuspend rather than a "
"normal suspend when the timer expires."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:731
msgid "``memalloc_noio``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:732
msgid ""
"Indicates memory allocation during runtime PM transitions must avoid I/O "
"(GFP_NOIO)."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:733
msgid "``links_count``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:734
msgid "Number of device links that require runtime PM coordination."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:734
msgid "``request``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:735
msgid "Type of pending runtime PM request (valid if request_pending is set)."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:736
msgid "``runtime_status``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:737
msgid "Runtime PM status of the device."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:737
msgid "``last_status``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:738
msgid ""
"Last status captured before disabling runtime PM, or ``RPM_BLOCKED`` / "
"``RPM_INVALID``."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:739
msgid "``runtime_error``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:740
msgid ""
"Fatal error code returned by a failing callback, blocking helpers until "
"cleared."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:741
msgid "``autosuspend_delay``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:742
msgid "Delay time in milliseconds to be used for runtime autosuspend."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:743
msgid "``last_busy``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:744
msgid ""
"Timestamp in nanoseconds when pm_runtime_mark_last_busy() was last called. "
"Used in calculating inactivity periods for autosuspend."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:745
msgid "``active_time``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:746
msgid "Accumulated time in nanoseconds spent in ``RPM_ACTIVE`` state."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:746
msgid "``suspended_time``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:747
msgid "Accumulated time in nanoseconds spent in ``RPM_SUSPENDED`` state."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:748
msgid "``accounting_timestamp``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:749
msgid ""
"Timestamp in nanoseconds of the last runtime PM state accounting update."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:750
msgid "``subsys_data``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:751
msgid "Subsystem-specific power management data."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:751
msgid "``set_latency_tolerance``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:752
msgid "Callback for setting latency tolerance."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:752
msgid "``qos``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:753
msgid "Per-device PM Quality of Service (QoS) constraints."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:753
msgid "``detach_power_off``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:754
msgid "Indicates device should be detached from PM domain on power off."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:755
msgid ""
"Device power management information stored in the \"power\" member of struct "
"device."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:830
msgid "power management domain representation."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:832
msgid "``ops``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:833
msgid "Power management operations associated with this domain."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:833
msgid "``start``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:834
msgid "Called when a user needs to start the device via the domain."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:834
msgid "``detach``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:835
msgid "Called when removing a device from the domain."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:835
msgid "``activate``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:836
msgid "Called before executing probe routines for bus types and drivers."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:836
msgid "``sync``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:837
msgid "Called after successful driver probe."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:837
msgid "``dismiss``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:838
msgid "Called after unsuccessful driver probe and after driver removal."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:838
msgid "``set_performance_state``"
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:839
msgid "Called to request a new performance state."
msgstr ""

#: ../../../driver-api/pm/types:7: ../include/linux/pm.h:839
msgid ""
"Power domains provide callbacks that are executed during system suspend, "
"hibernation, system resume and during runtime PM transitions instead of "
"subsystem-level and driver-level callbacks."
msgstr ""
