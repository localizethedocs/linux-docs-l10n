msgid ""
"function to read or write 64-bit register value of device. "
"debugfs_reg_access() and debugfs_reg64_access() are mutually exclusive, but "
"the 64-bit variant has precedence in case both are implemented."
msgstr ""

#: ../../../driver-api/iio/core:180: ../include/linux/iio/iio.h:496
msgid "``fwnode_xlate``"
msgstr ""

#: ../../../driver-api/iio/core:180: ../include/linux/iio/iio.h:497
msgid "fwnode based function pointer to obtain channel specifier index."
msgstr ""

#: ../../../driver-api/iio/core:180: ../include/linux/iio/iio.h:497
msgid "``hwfifo_set_watermark``"
msgstr ""

