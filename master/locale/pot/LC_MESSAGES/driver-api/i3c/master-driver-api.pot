"switching into I3C mode."
msgstr ""

#: ../../../driver-api/i3c/master-driver-api:9:
#: ../include/linux/i3c/master.h:313
msgid "``I3C_OPEN_DRAIN_NORMAL_SPEED``"
msgstr ""

#: ../../../driver-api/i3c/master-driver-api:9:
#: ../include/linux/i3c/master.h:314
msgid "Normal open-drain speed in I3C bus mode."
msgstr ""

#: ../../../driver-api/i3c/master-driver-api:9:
#: ../include/linux/i3c/master.h:314
