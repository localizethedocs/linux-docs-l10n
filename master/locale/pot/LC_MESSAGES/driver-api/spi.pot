"automatically be unregistered."
msgstr ""

#: ../../../driver-api/spi:52: ../drivers/spi/spi.c:3840
msgid "unregister SPI host or target controller"
msgstr ""

#: ../../../driver-api/spi:52: ../drivers/spi/spi.c:3841
