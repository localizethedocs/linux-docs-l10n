msgid "the **spi_controller** for this transfer"
msgstr ""

#: ../../../driver-api/spi:52: ../drivers/spi/spi.c:4172
#: ../drivers/spi/spi.c:4214 ../drivers/spi/spi.c:4743
#: ../drivers/spi/spi.c:4793 ../drivers/spi/spi.c:4841
