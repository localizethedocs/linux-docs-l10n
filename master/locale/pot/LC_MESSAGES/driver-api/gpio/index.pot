msgid "General Purpose Input/Output (GPIO)"
msgstr ""

#: ../../../driver-api/gpio/index.rst:5
msgid "Contents:"
msgstr ""

#: ../../../driver-api/gpio/index.rst:21
msgid "Core"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:48
msgid "GPIO interrupt controller"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:52
#: ../include/linux/gpio/driver.h:328 ../include/linux/gpio/driver.h:717
msgid "**Definition**::"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:91
#: ../include/linux/gpio/driver.h:367 ../include/linux/gpio/driver.h:725
msgid "**Members**"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:52
msgid "``chip``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:53
msgid "GPIO IRQ chip implementation, provided by GPIO driver."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:59
msgid "``domain``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:60
msgid ""
"Interrupt translation domain; responsible for mapping between GPIO hwirq "
"number and Linux IRQ number."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:68
#: ../include/linux/gpio/driver.h:329
msgid "``fwnode``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:69
msgid ""
"Firmware node corresponding to this gpiochip/irqchip, necessary for "
"hierarchical irqdomain support."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:76
msgid "``parent_domain``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:77
msgid ""
"If non-NULL, will be set as the parent of this GPIO interrupt controller's "
"IRQ domain to establish a hierarchical interrupt domain. The presence of "
"this will activate the hierarchical interrupt support."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:86
msgid "``child_to_parent_hwirq``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:87
msgid ""
"This callback translates a child hardware IRQ offset to a parent hardware "
"IRQ offset on a hierarchical interrupt chip. The child hardware IRQs "
"correspond to the GPIO index 0..ngpio-1 (see the ngpio field of struct "
"gpio_chip) and the corresponding parent hardware IRQ and type (such as "
"IRQ_TYPE_*) shall be returned by the driver. The driver can calculate this "
"from an offset or using a lookup table or whatever method is best for this "
"chip. Return 0 on successful translation in the driver."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:96
msgid ""
"If some ranges of hardware IRQs do not have a corresponding parent HWIRQ, "
"return -EINVAL, but also make sure to fill in **valid_mask** and "
"**need_valid_mask** to make these GPIO lines unavailable for translation."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:109
msgid "``populate_parent_alloc_arg``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:110
msgid ""
"This optional callback allocates and populates the specific struct for the "
"parent's IRQ domain. If this is not specified, then :c:type:"
"`gpiochip_populate_parent_fwspec_twocell` will be used. A four-cell variant "
"named :c:type:`gpiochip_populate_parent_fwspec_fourcell` is also available."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:123
msgid "``child_offset_to_irq``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:124
msgid ""
"This optional callback is used to translate the child's GPIO line offset on "
"the GPIO chip to an IRQ number for the GPIO to_irq() callback. If this is "
"not specified, then a default callback will be provided that returns the "
"line offset."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:134
msgid "``child_irq_domain_ops``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:135
msgid ""
"The IRQ domain operations that will be used for this GPIO IRQ chip. If no "
"operations are provided, then default callbacks will be populated to setup "
"the IRQ hierarchy. Some drivers need to supply their own translate function."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:145
msgid "``handler``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:146
msgid ""
"The IRQ handler to use (often a predefined IRQ core function) for GPIO IRQs, "
"provided by GPIO driver."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:153
msgid "``default_type``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:154
msgid ""
"Default IRQ triggering type applied during GPIO driver initialization, "
"provided by GPIO driver."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:161
msgid "``lock_key``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:162
msgid "Per GPIO IRQ chip lockdep class for IRQ lock."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:168
msgid "``request_key``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:169
msgid "Per GPIO IRQ chip lockdep class for IRQ request."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:175
msgid "``parent_handler``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:176
msgid ""
"The interrupt handler for the GPIO chip's parent interrupts, may be NULL if "
"the parent interrupts are nested rather than cascaded."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:1
msgid "``{unnamed_union}``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:2
msgid "anonymous"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:184
msgid "``parent_handler_data``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:185
msgid ""
"If **per_parent_data** is false, **parent_handler_data** is a single pointer "
"used as the data associated with every parent interrupt."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:193
msgid "``parent_handler_data_array``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:194
msgid ""
"If **per_parent_data** is true, **parent_handler_data_array** is an array of "
"**num_parents** pointers, and is used to associate different data for each "
"parent. This cannot be NULL if **per_parent_data** is true."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:204
msgid "``num_parents``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:205
msgid "The number of interrupt parents of a GPIO chip."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:211
msgid "``parents``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:212
msgid ""
"A list of interrupt parents of a GPIO chip. This is owned by the driver, so "
"the core will only reference this list, not modify it."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:219
msgid "``map``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:220
msgid "A list of interrupt parents for each line of a GPIO chip."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:226
msgid "``threaded``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:227
msgid "True if set the interrupt handling uses nested threads."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:233
msgid "``per_parent_data``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:234
msgid ""
"True if parent_handler_data_array describes a **num_parents** sized array to "
"be used as parent data."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:241
msgid "``initialized``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:242
msgid ""
"Flag to track GPIO chip irq member's initialization. This flag will make "
"sure GPIO chip irq members are not used before they are initialized."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:250
msgid "``domain_is_allocated_externally``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:251
msgid ""
"True it the irq_domain was allocated outside of gpiolib, in which case "
"gpiolib won't free the irq_domain itself."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:258
msgid "``init_hw``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:259
msgid ""
"optional routine to initialize hardware before an IRQ chip will be added. "
"This is quite useful when a particular driver wants to clear IRQ related "
"registers in order to avoid undesired events."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:266
#: ../include/linux/gpio/driver.h:367
msgid "``init_valid_mask``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:267
msgid ""
"optional routine to initialize **valid_mask**, to be used if not all GPIO "
"lines are valid interrupts. Sometimes some lines just cannot fire "
"interrupts, and this routine, when defined, is passed a bitmap in "
"\"valid_mask\" and it will have ngpios bits from 0..(ngpios-1) set to \"1\" "
"as in valid. The callback can then directly set some bits to \"0\" if they "
"cannot be used for interrupts."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:279
msgid "``valid_mask``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:280
msgid ""
"If not ``NULL``, holds bitmask of GPIOs which are valid to be included in "
"IRQ domain of the chip."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:287
msgid "``first``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:288
msgid ""
"Required for static IRQ allocation. If set, irq_domain_create_simple() will "
"allocate and map all IRQs during initialization."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:296
msgid "``irq_enable``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:297
msgid "Store old irq_chip irq_enable callback"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:303
msgid "``irq_disable``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:304
msgid "Store old irq_chip irq_disable callback"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:309
msgid "``irq_unmask``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:310
msgid "Store old irq_chip irq_unmask callback"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:316
msgid "``irq_mask``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:317
msgid "Store old irq_chip irq_mask callback"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:324
msgid "abstract a GPIO controller"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:325
msgid "``label``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:326
msgid ""
"a functional name for the GPIO device, such as a part number or the name of "
"the SoC IP-block implementing it."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:327
msgid "``gpiodev``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:328
msgid "the internal state holder, opaque struct"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:328
msgid "``parent``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:329
msgid "optional parent device providing the GPIOs"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:330
msgid "optional fwnode providing this controller's properties"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:330
msgid "``owner``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:331
msgid "helps prevent removal of modules exporting active GPIOs"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:331
msgid "``request``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:332
msgid ""
"optional hook for chip-specific activation, such as enabling module power "
"and clock; may sleep; must return 0 on success or negative error number on "
"failure"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:334
msgid "``free``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:335
msgid ""
"optional hook for chip-specific deactivation, such as disabling module power "
"and clock; may sleep"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:336
msgid "``get_direction``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:337
msgid ""
"returns direction for signal \"offset\", 0=out, 1=in, (same as "
"GPIO_LINE_DIRECTION_OUT / GPIO_LINE_DIRECTION_IN), or negative error. It is "
"recommended to always implement this function, even on input-only or output-"
"only gpio chips."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:340
msgid "``direction_input``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:341
msgid ""
"configures signal \"offset\" as input, returns 0 on success or a negative "
"error number. This can be omitted on input-only or output-only gpio chips."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:343
msgid "``direction_output``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:344
msgid ""
"configures signal \"offset\" as output, returns 0 on success or a negative "
"error number. This can be omitted on input-only or output-only gpio chips."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:346
msgid "``get``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:347
msgid ""
"returns value for signal \"offset\", 0=low, 1=high, or negative error. the "
"low and high values are defined as physical low on the line in/out to the "
"connector such as a physical pad, pin or rail. The GPIO library has internal "
"logic to handle lines that are active low, such as indicated by overstrike "
"or #name in a schematic, and the driver should not try to second-guess the "
"logic value of a line."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:352
msgid "``get_multiple``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:353
msgid ""
"reads values for multiple signals defined by \"mask\" and stores them in "
"\"bits\", returns 0 on success or negative error"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:354
msgid "``set``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:355
msgid ""
"assigns output value for signal \"offset\", returns 0 on success or negative "
"error value. The output value follows the same semantic rules as for **get**."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:357
msgid "``set_multiple``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:358
msgid ""
"assigns output values for multiple signals defined by \"mask\", returns 0 on "
"success or negative error value"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:359
msgid "``set_config``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:360
msgid ""
"optional hook for all kinds of settings. Uses the same packed config format "
"as generic pinconf. Must return 0 on success and a negative error number on "
"failure."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:362
msgid "``to_irq``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:363
msgid ""
"optional hook supporting non-static gpiod_to_irq() mappings; implementation "
"may not sleep"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:364
msgid "``dbg_show``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:365
msgid ""
"optional routine to show contents in debugfs; default code will be used when "
"this is omitted, but custom code can show extra state (such as pullup/"
"pulldown configuration)."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:368
msgid ""
"optional routine to initialize **valid_mask**, to be used if not all GPIOs "
"are valid."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:369
msgid "``add_pin_ranges``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:370
msgid ""
"optional routine to initialize pin ranges, to be used when requires special "
"mapping of the pins that provides GPIO functionality. It is called after "
"adding GPIO chip and before adding IRQ chip."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:372
msgid "``en_hw_timestamp``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:373
msgid ""
"Dependent on GPIO chip, an optional routine to enable hardware timestamp."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:374
msgid "``dis_hw_timestamp``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:375
msgid ""
"Dependent on GPIO chip, an optional routine to disable hardware timestamp."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:376
msgid "``base``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:377
msgid ""
"identifies the first GPIO number handled by this chip; or, if negative "
"during registration, requests dynamic ID allocation. DEPRECATION: providing "
"anything non-negative and nailing the base offset of GPIO chips is "
"deprecated. Please pass -1 as base to let gpiolib select the chip base in "
"all possible cases. We want to get rid of the static GPIO number space in "
"the long run."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:382
msgid "``ngpio``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:383
msgid ""
"the number of GPIOs handled by this controller; the last GPIO handled is "
"(base + ngpio - 1)."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:384
msgid "``offset``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:385
msgid ""
"when multiple gpio chips belong to the same device this can be used as "
"offset within the device so friendly names can be properly assigned."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:387
msgid "``names``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:388
msgid ""
"if set, must be an array of strings to use as alternative names for the "
"GPIOs in this chip. Any entry in the array may be NULL if there is no alias "
"for the GPIO, however the array must be **ngpio** entries long."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:391
msgid "``can_sleep``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:392
msgid ""
"flag must be set iff get()/set() methods sleep, as they must while accessing "
"GPIO expander chips over I2C or SPI. This implies that if the chip supports "
"IRQs, these IRQs need to be threaded as the chip access may sleep when e.g. "
"reading out the IRQ status registers."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:468
msgid "``irq``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:469
msgid ""
"Integrates interrupt chip functionality with the GPIO chip. Can be used to "
"handle IRQs for most practical cases."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:483
msgid "``of_gpio_n_cells``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:484
msgid ""
"Number of cells used to form the GPIO specifier. The standard is 2 cells:"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:487
msgid "gpios = <:c:type:`gpio` offset flags>;"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:489
msgid ""
"some complex GPIO controllers instantiate more than one chip per device tree "
"node and have 3 cells:"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:492
msgid "gpios = <:c:type:`gpio` instance offset flags>;"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:494
msgid "Legacy GPIO controllers may even have 1 cell:"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:496
msgid "gpios = <:c:type:`gpio` offset>;"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:502
msgid "``of_node_instance_match``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:503
msgid ""
"Determine if a chip is the right instance. Must be implemented by any driver "
"using more than one gpio_chip per device tree node. Returns true if gc is "
"the instance indicated by i (which is the first cell in the phandles for "
"GPIO lines and gpio-ranges)."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:512
msgid "``of_xlate``"
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:513
msgid ""
"Callback to translate a device tree GPIO specifier into a chip- relative "
"GPIO number and flags."
msgstr ""

#: ../../../driver-api/gpio/index:23: ../include/linux/gpio/driver.h:517
#: ../include/linux/gpio/driver.h:593 ../../../driver-api/gpio/index:26:
#: ../drivers/gpio/gpiolib.c:206 ../drivers/gpio/gpiolib.c:226
#: ../drivers/gpio/gpiolib.c:256 ../drivers/gpio/gpiolib.c:278
#: ../drivers/gpio/gpiolib.c:327 ../drivers/gpio/gpiolib.c:450
#: ../drivers/gpio/gpiolib.c:500 ../drivers/gpio/gpiolib.c:828
#: ../drivers/gpio/gpiolib.c:1409 ../drivers/gpio/gpiolib.c:1457
#: ../drivers/gpio/gpiolib.c:1577 ../drivers/gpio/gpiolib.c:2351
