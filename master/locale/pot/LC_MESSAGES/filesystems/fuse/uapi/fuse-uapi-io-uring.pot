#: ../../../filesystems/fuse/uapi/fuse-uapi-io-uring.rst:12
msgid "``FUSE_IO_URING_CMD_ADD_QUEUE``"
msgstr ""

#: ../../../filesystems/fuse/uapi/fuse-uapi-io-uring.rst:13
msgid ""
"Create a queue identified by ``fuse_uring_cmd_req.qid``. Queue-wide options "
"are passed in ``fuse_uring_cmd_req.flags``:"
msgstr ""

#: ../../../filesystems/fuse/uapi/fuse-uapi-io-uring.rst:16
msgid "``FUSE_URING_ZERO_COPY``"
msgstr ""

#: ../../../filesystems/fuse/uapi/fuse-uapi-io-uring.rst:17
msgid ""
"Enable zero-copy on this queue. Requires ``CAP_SYS_ADMIN`` and a buffer "
"pool, which is added separately via ``ADD_BUFPOOL`` before registering "
"entries (see `Zero-copy`_)."
msgstr ""

#: ../../../filesystems/fuse/uapi/fuse-uapi-io-uring.rst:21
msgid "``FUSE_IO_URING_CMD_ADD_BUFPOOL``"
msgstr ""

#: ../../../filesystems/fuse/uapi/fuse-uapi-io-uring.rst:22
msgid ""
"Register the payload buffer pool for an existing queue. The server provides "
"a single contiguous region in ``fuse_uring_cmd_req.bufpool.uaddr`` / ``."
"len``. This command must be issued after ``ADD_QUEUE`` and before "
"registering any payload-carrying entries on that queue. ``fuse_uring_cmd_req."
"flags`` must be 0. Submitting this command with ``IORING_URING_CMD_FIXED`` "
"marks the pool as registered, which avoids per i/o pinning/unpinning and "
"mapping overhead (see `Buffer pools`_)."
msgstr ""

#: ../../../filesystems/fuse/uapi/fuse-uapi-io-uring.rst:30
msgid "``FUSE_IO_URING_CMD_REGISTER``"
msgstr ""

#: ../../../filesystems/fuse/uapi/fuse-uapi-io-uring.rst:31
msgid ""
"Register a ring entry (a long-lived SQE that carries the request header "
"iovec). For a zero-copy queue, ``fuse_uring_cmd_req."
"ent_zero_copy_buf_index`` indicates the reserved registered buffer table "
"slot this entry uses for zero-copy (see `Zero-copy`_)."
msgstr ""

#: ../../../filesystems/fuse/uapi/fuse-uapi-io-uring.rst:36
msgid "``FUSE_IO_URING_CMD_COMMIT_AND_FETCH``"
msgstr ""

#: ../../../filesystems/fuse/uapi/fuse-uapi-io-uring.rst:37
msgid ""
"Commit the reply for a completed request and fetch the next one. The request "
"is identified by ``fuse_uring_cmd_req.commit_id`` (the value the kernel "
"reported in ``fuse_uring_ent_in_out.commit_id``)."
msgstr ""

