#: ../../../block/error-injection.rst:5
msgid "Configurable Error Injection"
msgstr ""

#: ../../../block/error-injection.rst:8
msgid "Overview"
msgstr ""

#: ../../../block/error-injection.rst:10
msgid ""
"Configurable error injection allows injecting specific block layer status "
"codes for sector ranges of a block device.  Errors can be injected "
"unconditionally, or with a given probability."
msgstr ""

#: ../../../block/error-injection.rst:14
msgid ""
"To use configurable error injection, CONFIG_BLK_ERROR_INJECTION must be "
"enabled."
msgstr ""

#: ../../../block/error-injection.rst:16
msgid ""
"The only interface is the error_injection debugfs file, which is created for "
"each registered gendisk.  Writes to this file are used to create or delete "
"rules and reads return a list of the current error injection sites."
msgstr ""

#: ../../../block/error-injection.rst:21
msgid "Options"
msgstr ""

#: ../../../block/error-injection.rst:23
msgid "The following options specify the operations:"
msgstr ""

#: ../../../block/error-injection.rst:26
msgid "add"
msgstr ""

#: ../../../block/error-injection.rst:26
msgid "add a new rule"
msgstr ""

#: ../../../block/error-injection.rst:27
msgid "removeall"
msgstr ""

#: ../../../block/error-injection.rst:27
msgid "remove all existing rules"
msgstr ""

#: ../../../block/error-injection.rst:30
msgid ""
"The following options specify the details of the rule for the add operation:"
msgstr ""

#: ../../../block/error-injection.rst:33
msgid "op=<string>"
msgstr ""

#: ../../../block/error-injection.rst:33
msgid ""
"block layer operation this rule applies to.  This uses the XYZ for each "
"REQ_OP_XYZ operation, e.g. READ, WRITE or DISCARD. Mandatory."
msgstr ""

#: ../../../block/error-injection.rst:36
msgid "status=<string>"
msgstr ""

#: ../../../block/error-injection.rst:36
msgid ""
"Status to return.  This uses XYZ for each BLK_STS_XYZ code, e.g. IOERR or "
"MEDIUM. Mandatory."
msgstr ""

#: ../../../block/error-injection.rst:38
msgid "start=<number>"
msgstr ""

#: ../../../block/error-injection.rst:38
msgid "First block layer sector the rule applies to. Optional, defaults to 0."
msgstr ""

#: ../../../block/error-injection.rst:40
msgid "nr_sectors=<number>"
msgstr ""

#: ../../../block/error-injection.rst:40
msgid ""
"Number of sectors this rule applies. Optional, defaults to the remainder of "
"the device."
msgstr ""

#: ../../../block/error-injection.rst:42
msgid "chance=<number>"
msgstr ""

#: ../../../block/error-injection.rst:42
msgid ""
"Only return a failure with a likelihood of 1/chance. Optional, defaults to 1 "
"(always)."
msgstr ""

#: ../../../block/error-injection.rst:47
msgid "Example"
msgstr ""

#: ../../../block/error-injection.rst:49
msgid "Return BLK_STS_IOERR for one in 10 reads of sector 0 of /dev/nvme0n1:"
msgstr ""

#: ../../../block/error-injection.rst:51
msgid ""
"$ echo 'add,op=READ,start=0,status=IOERR,chance=10' > /sys/kernel/debug/"
"block/nvme0n1/error_injection"
msgstr ""

#: ../../../block/error-injection.rst:53
msgid "Return BLK_STS_MEDIUM for every write to /dev/nvme0n1:"
msgstr ""

#: ../../../block/error-injection.rst:55
msgid ""
"$ echo 'add,op=WRITE,start=0,status=MEDIUM' > /sys/kernel/debug/block/"
"nvme0n1/error_injection"
msgstr ""

#: ../../../block/error-injection.rst:57
msgid "Remove all rules for /dev/nvme0n1:"
msgstr ""

#: ../../../block/error-injection.rst:59
msgid "$ echo 'removeall' > /sys/kernel/debug/block/nvme0n1/error_injection"
msgstr ""
