#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:416
msgid "whether underruns should be reported or not"
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:389
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:418
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:466
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:500
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:519
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:547
msgid "**Description**"
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:388
msgid ""
"This function sets the fifo underrun state for **pipe**. It is used in the "
"modeset code to avoid false positives since on many platforms underruns are "
"expected when disabling or enabling the pipe."
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:392
msgid ""
"Notice that on some platforms disabling underrun reports for one pipe "
"disables for all due to shared interrupts. Actual reporting is still per-"
"pipe though."
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:396
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:423
msgid "Returns the previous state of underrun reporting."
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:413
msgid "set PCH fifo underrun reporting state"
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:416
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:499
msgid "``enum pipe pch_transcoder``"
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:415
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:498
msgid "the PCH transcoder (same as pipe on IVB and older)"
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:417
msgid ""
"This function makes us disable or enable PCH fifo underruns for a specific "
"PCH transcoder. Notice that on some PCHs (e.g. CPT/PPT), disabling FIFO "
"underrun reporting for one transcoder may also disable all the other PCH "
"error interruts for the other transcoders, due to the fact that there's just "
"one interrupt mask/enable bit for all the transcoders."
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:462
msgid "handle CPU fifo underrun interrupt"
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:465
msgid ""
"This handles a CPU fifo underrun interrupt, generating an underrun warning "
"into dmesg if underrun reporting is enabled and then disables the underrun "
"interrupt to avoid an irq storm."
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:496
msgid "handle PCH fifo underrun interrupt"
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:499
msgid ""
"This handles a PCH fifo underrun interrupt, generating an underrun warning "
"into dmesg if underrun reporting is enabled and then disables the underrun "
"interrupt to avoid an irq storm."
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:516
msgid "check for CPU fifo underruns immediately"
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:518
msgid ""
"Check for CPU fifo underruns immediately. Useful on IVB/HSW where the shared "
"error interrupt may have been disabled, and so CPU fifo underruns won't "
"necessarily raise an interrupt, and on GMCH platforms where underruns never "
"raise an interrupt."
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:544
msgid "check for PCH fifo underruns immediately"
msgstr ""

#: ../../../gpu/intel-display/fifo-underrun:10:
#: ../drivers/gpu/drm/i915/display/intel_fifo_underrun.c:546
msgid ""
"Check for PCH fifo underruns immediately. Useful on CPT/PPT where the shared "
"error interrupt may have been disabled, and so PCH fifo underruns won't "
"necessarily raise an interrupt."
msgstr ""
