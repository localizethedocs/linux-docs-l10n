#: ../../../networking/mptcp-sysctl.rst:5
msgid "MPTCP Sysfs variables"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:8
msgid "/proc/sys/net/mptcp/* Variables"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:10
msgid "add_addr_timeout - INTEGER (seconds)"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:11
msgid ""
"Set the maximum value of timeout after which an ADD_ADDR control message "
"will be resent to an MPTCP peer that has not acknowledged a previous "
"ADD_ADDR message. A dynamically estimated retransmission timeout based on "
"the estimated connection round-trip-time is used if this value is lower than "
"the maximum one."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:17
msgid "Do not retransmit if set to 0."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:19
msgid "The default value matches TCP_RTO_MAX. This is a per-namespace sysctl."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:22
msgid "Default: 120"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:24
msgid "add_addr_v6_port_drop_ts - BOOLEAN"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:25
msgid ""
"Control whether preparing an ADD_ADDR with an IPv6 address and a port should "
"drop the TCP timestamps option to have enough option space to send the "
"signal."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:29
msgid ""
"If there is not enough option space, and the TCP timestamps option cannot be "
"dropped, the signal cannot be sent. Note that dropping the TCP timestamps "
"option for one packet of the connection could disrupt some middleboxes: even "
"if it should be unlikely, they could drop the packet or block the "
"connection. This is a per-namespace sysctl."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:35
#: ../../../networking/mptcp-sysctl.rst:94
msgid "Default: 1 (enabled)"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:37
msgid "allow_join_initial_addr_port - BOOLEAN"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:38
msgid ""
"Allow peers to send join requests to the IP address and port number used by "
"the initial subflow if the value is 1. This controls a flag that is sent to "
"the peer at connection time, and whether such join requests are accepted or "
"denied."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:43
msgid ""
"Joins to addresses advertised with ADD_ADDR are not affected by this value."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:46
#: ../../../networking/mptcp-sysctl.rst:106
#: ../../../networking/mptcp-sysctl.rst:123
#: ../../../networking/mptcp-sysctl.rst:148
msgid "This is a per-namespace sysctl."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:48
msgid "Default: 1"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:50
msgid "available_path_managers - STRING"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:51
msgid ""
"Shows the available path managers choices that are registered. More path "
"managers may be available, but not loaded."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:54
msgid "available_schedulers - STRING"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:55
msgid ""
"Shows the available schedulers choices that are registered. More packet "
"schedulers may be available, but not loaded."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:58
msgid "blackhole_timeout - INTEGER (seconds)"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:59
msgid ""
"Initial time period in second to disable MPTCP on active MPTCP sockets when "
"a MPTCP firewall blackhole issue happens. This time period will grow "
"exponentially when more blackhole issues get detected right after MPTCP is "
"re-enabled and will reset to the initial value when the blackhole issue goes "
"away."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:65
msgid "0 to disable the blackhole detection. This is a per-namespace sysctl."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:67
msgid "Default: 3600"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:69
msgid "checksum_enabled - BOOLEAN"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:70
msgid "Control whether DSS checksum can be enabled."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:72
msgid ""
"DSS checksum can be enabled if the value is nonzero. This is a per-namespace "
"sysctl."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:75
#: ../../../networking/mptcp-sysctl.rst:130
msgid "Default: 0"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:77
msgid "close_timeout - INTEGER (seconds)"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:78
msgid ""
"Set the make-after-break timeout: in absence of any close or shutdown "
"syscall, MPTCP sockets will maintain the status unchanged for such time, "
"after the last subflow removal, before moving to TCP_CLOSE."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:83
msgid ""
"The default value matches TCP_TIMEWAIT_LEN. This is a per-namespace sysctl."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:86
msgid "Default: 60"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:88
msgid "enabled - BOOLEAN"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:89
msgid "Control whether MPTCP sockets can be created."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:91
msgid ""
"MPTCP sockets can be created if the value is 1. This is a per-namespace "
"sysctl."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:96
msgid "path_manager - STRING"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:97
msgid ""
"Set the default path manager name to use for each new MPTCP socket. In-"
"kernel path management will control subflow connections and address "
"advertisements according to per-namespace values configured over the MPTCP "
"netlink API. Userspace path management puts per-MPTCP-connection subflow "
"connection decisions and address advertisements under control of a "
"privileged userspace program, at the cost of more netlink traffic to "
"propagate all of the related events and commands."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:108
msgid "\"kernel\"          - In-kernel path manager"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:109
msgid "\"userspace\"       - Userspace path manager"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:111
msgid "Default: \"kernel\""
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:113
msgid "pm_type - INTEGER"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:114
msgid ""
"Set the default path manager type to use for each new MPTCP socket. In-"
"kernel path management will control subflow connections and address "
"advertisements according to per-namespace values configured over the MPTCP "
"netlink API. Userspace path management puts per-MPTCP-connection subflow "
"connection decisions and address advertisements under control of a "
"privileged userspace program, at the cost of more netlink traffic to "
"propagate all of the related events and commands."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:125
msgid "Deprecated since v6.15, use path_manager instead."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:127
msgid "0 - In-kernel path manager"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:128
msgid "1 - Userspace path manager"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:132
msgid "scheduler - STRING"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:133
msgid "Select the scheduler of your choice."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:135
msgid ""
"Support for selection of different schedulers. This is a per-namespace "
"sysctl."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:138
msgid "Default: \"default\""
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:140
msgid "stale_loss_cnt - INTEGER"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:141
msgid ""
"The number of MPTCP-level retransmission intervals with no traffic and "
"pending outstanding data on a given subflow required to declare it stale. "
"The packet scheduler ignores stale subflows. A low stale_loss_cnt  value "
"allows for fast active-backup switch-over, an high value maximize links "
"utilization on edge scenarios e.g. lossy link with high BER or peer pausing "
"the data processing."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:150
msgid "Default: 4"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:152
msgid "syn_retrans_before_tcp_fallback - INTEGER"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:153
msgid ""
"The number of SYN + MP_CAPABLE retransmissions before falling back to TCP, i."
"e. dropping the MPTCP options. In other words, if all the packets are "
"dropped on the way, there will be:"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:157
msgid "The initial SYN with MPTCP support"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:158
msgid "This number of SYN retransmitted with MPTCP support"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:159
msgid "The next SYN retransmissions will be without MPTCP support"
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:161
msgid ""
"0 means the first retransmission will be done without MPTCP options. >= 128 "
"means that all SYN retransmissions will keep the MPTCP options. A lower "
"number might increase false-positive MPTCP blackholes detections. This is a "
"per-namespace sysctl."
msgstr ""

#: ../../../networking/mptcp-sysctl.rst:166
msgid "Default: 2"
msgstr ""
