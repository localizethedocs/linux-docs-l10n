msgstr ""

#: ../../../sound/codecs/tas675x.rst:300
msgid "The TAS675x provides three load diagnostic modes:"
msgstr ""

#: ../../../sound/codecs/tas675x.rst:302
msgid "DC Load Diagnostics (DC LDG)"
msgstr ""

#: ../../../sound/codecs/tas675x.rst:303
msgid ""
"Measures DC resistance to detect S2G (short-to-ground), S2P (short-to-"
"power), OL (open load), and SL (shorted load) faults."
msgstr ""

#: ../../../sound/codecs/tas675x.rst:306
msgid "AC Load Diagnostics (AC LDG)"
msgstr ""

#: ../../../sound/codecs/tas675x.rst:307
msgid ""
"Measures complex AC impedance at a configurable frequency. Detects "
"capacitive loads and tweeter configurations."
msgstr ""

#: ../../../sound/codecs/tas675x.rst:310
msgid "Real-Time Load Diagnostics (RTLDG)"
msgstr ""

#: ../../../sound/codecs/tas675x.rst:311
msgid ""
"Monitors impedance continuously during playback using a pilot tone. Normal "
"DSP mode only, at 48 kHz or 96 kHz."
msgstr ""

#: ../../../sound/codecs/tas675x.rst:315
msgid "Fast Boot Mode"
msgstr ""

#: ../../../sound/codecs/tas675x.rst:317
msgid ""
"By default the device runs DC load diagnostics at initialization before "
"accepting audio. Setting ``ti,fast-boot`` in the device tree bypasses this "
"initial diagnostic run for faster startup. Automatic diagnostics after fault "
"recovery remain enabled."
msgstr ""

